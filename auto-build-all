#!/usr/bin/env bash
set -euo pipefail

# auto-build-all — one-click setup: deps + tools + build
# Run from repository root: ./auto-build-all

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_BASE="$HOME/.claude/plugins/cache/thedotmack/claude-mem"

# ── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
info() { printf "  ${BLUE}→${RESET} %s\n" "$1"; }
step() { printf "\n${BOLD}%s${RESET}\n" "$1"; }

# ── 1. Bun ──────────────────────────────────────────────────────────
step "Checking Bun runtime..."
if command -v bun &>/dev/null; then
  ok "Bun $(bun --version) at $(command -v bun)"
else
  if [[ -f "$HOME/.bun/bin/bun" ]]; then
    export PATH="$HOME/.bun/bin:$PATH"
    ok "Bun $(bun --version) found at ~/.bun/bin (added to PATH)"
  else
    info "Installing Bun..."
    curl -fsSL https://bun.sh/install | bash
    export PATH="$HOME/.bun/bin:$PATH"
    if command -v bun &>/dev/null; then
      ok "Bun $(bun --version) installed"
    else
      fail "Bun installation failed"
      exit 1
    fi
  fi
fi
# Ensure bun is in PATH for subshells
export PATH="$HOME/.bun/bin:$PATH"

# ── 2. npm dependencies ────────────────────────────────────────────
step "Installing npm dependencies..."
if [[ -d "$SCRIPT_DIR/node_modules" ]]; then
  ok "node_modules exists"
else
  info "Running npm install --ignore-scripts (skip native module build)..."
  (cd "$SCRIPT_DIR" && npm install --ignore-scripts)
  ok "Dependencies installed"
fi

# esbuild is required for build but gets skipped by --ignore-scripts
if ! node -e "require('esbuild')" 2>/dev/null; then
  info "Installing esbuild..."
  (cd "$SCRIPT_DIR" && npm install --ignore-scripts esbuild)
  ok "esbuild installed"
else
  ok "esbuild available"
fi

# ── 3. Cache directory ─────────────────────────────────────────────
mkdir -p "$CACHE_BASE"

# ── 4. Build ────────────────────────────────────────────────────────
step "Building claude-mem..."
(cd "$SCRIPT_DIR" && npm run build)
if [[ -f "$SCRIPT_DIR/plugin/scripts/worker-service.cjs" ]]; then
  ok "Build successful"
else
  fail "Build failed — plugin/scripts/worker-service.cjs not found"
  exit 1
fi

# ── Done ────────────────────────────────────────────────────────────
printf "\n${BOLD}${GREEN}All done!${RESET} Next step:\n\n"
printf "  ./install-claude-mem -i claude     # Install for Claude Code\n"
printf "  ./install-claude-mem -i codex      # Install for Codex CLI\n\n"
