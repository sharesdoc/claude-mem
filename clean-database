#!/usr/bin/env bash
set -euo pipefail

# clean-database — 清理 claude-mem 数据库中的孤立记录并重建 Chroma 向量库
#
# Usage:
#   ./clean-database           Interactive mode (shows report, asks confirmation)
#   ./clean-database -y        Non-interactive (skip confirmation)
#   ./clean-database -n        Dry-run (report only, no changes)
#   ./clean-database -h        Show help

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DATA_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
DB="$DATA_DIR/claude-mem.db"
CHROMA_DB="$DATA_DIR/chroma/chroma.sqlite3"
WORKER_SCRIPT="$SCRIPT_DIR/plugin/scripts/worker-service.cjs"
WORKER_PORT="${CLAUDE_MEM_WORKER_PORT:-$((37700 + $(id -u) % 100))}"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'
BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
info() { printf "  ${DIM}→${RESET} %s\n" "$1"; }

# ── Help ─────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF
clean-database — clean orphaned records from claude-mem database & rebuild Chroma

${BOLD}Usage:${RESET}
  ./clean-database            Show integrity report, then ask for confirmation
  ./clean-database -y         Skip confirmation — execute cleanup immediately
  ./clean-database -n         Dry-run — show report only, make no changes
  ./clean-database -h         Show this help

${BOLD}What gets cleaned:${RESET}
  • observations          Rows whose memory_session_id doesn't exist in sdk_sessions
  • session_summaries     Same criterion
  • Chroma vector DB      Rebuilt from scratch (stale embeddings removed)

${BOLD}What is NOT affected:${RESET}
  • sdk_sessions          Never touched
  • user_prompts          Never touched
  • settings.json         Never touched

${BOLD}Safety:${RESET}
  • Worker is stopped before any changes
  • Integrity report is shown before any deletion
  • FK is enforced (PRAGMA foreign_keys = ON) during deletion
  • FTS indexes are auto-cleaned via triggers
  • Chroma is rebuilt from valid data after cleanup
  • Worker is restarted after cleanup

${BOLD}Examples:${RESET}
  ./clean-database           # Interactive
  ./clean-database -n        # Just see what would be cleaned
  ./clean-database -y        # Run without prompts

${BOLD}Database:${RESET}  $DB
${BOLD}Chroma:${RESET}     $CHROMA_DB
EOF
}

# ── Parse flags ──────────────────────────────────────────────────────
AUTO_YES=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)   AUTO_YES=true; shift ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    -h|--help)  show_help; exit 0 ;;
    *)          fail "Unknown flag: $1"; show_help; exit 1 ;;
  esac
done

# ── Pre-flight checks ────────────────────────────────────────────────
if [[ ! -f "$DB" ]]; then
  fail "Database not found: $DB"
  exit 1
fi

if ! command -v sqlite3 &>/dev/null; then
  fail "sqlite3 not found — install it first"
  exit 1
fi

# ── Worker helpers ───────────────────────────────────────────────────
worker_is_running() {
  curl -sf "http://127.0.0.1:${WORKER_PORT}/api/health" -o /dev/null --connect-timeout 1 --max-time 2 2>/dev/null
}

stop_worker() {
  if worker_is_running; then
    info "Stopping worker on port ${WORKER_PORT}..."
    if [[ -f "$WORKER_SCRIPT" ]]; then
      cd "$SCRIPT_DIR" && bun "$WORKER_SCRIPT" stop 2>/dev/null || true
    fi
    sleep 2
    # Wait for port release
    local waited=0
    while worker_is_running; do
      sleep 1
      waited=$((waited + 1))
      if [[ $waited -ge 15 ]]; then
        warn "Worker did not stop gracefully — force killing"
        pkill -f "worker-service.cjs" 2>/dev/null || true
        sleep 2
        break
      fi
    done
    ok "Worker stopped"
  else
    info "Worker not running — skipping stop"
  fi
}

start_worker() {
  if [[ -f "$WORKER_SCRIPT" ]]; then
    info "Starting worker..."
    cd "$SCRIPT_DIR" && bun "$WORKER_SCRIPT" start 2>/dev/null || true
    sleep 2
    if worker_is_running; then
      ok "Worker restarted on port ${WORKER_PORT}"
    else
      warn "Worker may still be starting — check: curl http://127.0.0.1:${WORKER_PORT}/api/health"
    fi
  fi
}

# ── Chroma helpers ───────────────────────────────────────────────────
chroma_running() {
  pgrep -f "chroma-mcp" &>/dev/null
}

stop_chroma() {
  if chroma_running; then
    info "Stopping Chroma MCP processes..."
    pkill -f "chroma-mcp" 2>/dev/null || true
    sleep 2
    local waited=0
    while chroma_running; do
      sleep 1
      waited=$((waited + 1))
      if [[ $waited -ge 10 ]]; then
        warn "Chroma did not stop — force killing"
        pkill -9 -f "chroma-mcp" 2>/dev/null || true
        sleep 1
        break
      fi
    done
    ok "Chroma stopped"
  else
    info "Chroma not running"
  fi
}

# ── Integrity report ─────────────────────────────────────────────────
show_report() {
  echo ""
  printf "  ${BOLD}%s${RESET}\n" "========== Integrity Report =========="
  echo ""

  local total_obs orphan_obs orphan_obs_ids total_sums orphan_sums orphan_sum_ids
  total_obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations;")
  orphan_obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations o LEFT JOIN sdk_sessions s ON s.memory_session_id = o.memory_session_id WHERE s.memory_session_id IS NULL;")
  orphan_obs_ids=$(sqlite3 "$DB" "SELECT COUNT(DISTINCT o.memory_session_id) FROM observations o LEFT JOIN sdk_sessions s ON s.memory_session_id = o.memory_session_id WHERE s.memory_session_id IS NULL;")
  total_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries;")
  orphan_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries ss LEFT JOIN sdk_sessions s ON s.memory_session_id = ss.memory_session_id WHERE s.memory_session_id IS NULL;")
  orphan_sum_ids=$(sqlite3 "$DB" "SELECT COUNT(DISTINCT ss.memory_session_id) FROM session_summaries ss LEFT JOIN sdk_sessions s ON s.memory_session_id = ss.memory_session_id WHERE s.memory_session_id IS NULL;")

  local total_sessions
  total_sessions=$(sqlite3 "$DB" "SELECT COUNT(*) FROM sdk_sessions;")

  local chroma_emb=0 chroma_size="N/A"
  if [[ -f "$CHROMA_DB" ]]; then
    chroma_emb=$(sqlite3 "$CHROMA_DB" "SELECT COUNT(*) FROM embeddings;" 2>/dev/null || echo 0)
    chroma_size=$(ls -lh "$CHROMA_DB" | awk '{print $5}')
  fi

  printf "  ${BOLD}Main Database:${RESET} %s\n" "$(ls -lh "$DB" | awk '{print $5}')"
  printf "  %-30s %6s total, ${RED}%6s orphan${RESET} (%s unique IDs)\n" \
    "observations" "$total_obs" "$orphan_obs" "$orphan_obs_ids"
  printf "  %-30s %6s total, ${RED}%6s orphan${RESET} (%s unique IDs)\n" \
    "session_summaries" "$total_sums" "$orphan_sums" "$orphan_sum_ids"
  printf "  %-30s %6s (all valid)\n" "sdk_sessions" "$total_sessions"

  echo ""
  printf "  ${BOLD}Chroma Vector DB:${RESET} %s\n" "$chroma_size"
  if [[ "$chroma_emb" -gt 0 ]]; then
    local chroma_ok chroma_orphan chroma_zombie
    chroma_ok=$(sqlite3 "$CHROMA_DB" \
      "ATTACH '$DB' AS cm; SELECT COUNT(*) FROM embedding_metadata em WHERE em.key='memory_session_id' AND em.string_value IN (SELECT memory_session_id FROM cm.sdk_sessions WHERE memory_session_id IS NOT NULL);" 2>/dev/null || echo 0)
    chroma_orphan=$(sqlite3 "$CHROMA_DB" \
      "ATTACH '$DB' AS cm; SELECT COUNT(*) FROM embedding_metadata em WHERE em.key='memory_session_id' AND em.string_value IN (SELECT o.memory_session_id FROM cm.observations o LEFT JOIN cm.sdk_sessions s ON s.memory_session_id = o.memory_session_id WHERE s.memory_session_id IS NULL);" 2>/dev/null || echo 0)
    printf "  %-30s %6s total, ${GREEN}%6s valid${RESET}, ${RED}%6s stale${RESET}\n" \
      "embeddings" "$chroma_emb" "$chroma_ok" "$((chroma_emb - chroma_ok))"
  fi

  echo ""

  # Show affected query paths
  printf "  ${BOLD}Affected query paths:${RESET}\n"
  printf "  ${DIM}• Search (SessionSearch) — orphans appear in search results${RESET}\n"
  printf "  ${DIM}• Viewer feed (PaginationHelper) — orphans appear with NULL session${RESET}\n"
  printf "  ${DIM}• Context injection (ObservationCompiler) — orphans may be injected${RESET}\n"
  printf "  ${DIM}• Stats page (DataRoutes) — orphans inflate counts${RESET}\n"
  printf "  ${DIM}• Chroma vector search — stale embeddings degrade results${RESET}\n"

  echo ""
}

# ── Clean main database ──────────────────────────────────────────────
clean_main_db() {
  echo ""
  printf "  ${BOLD}%s${RESET}\n" "========== Cleaning Main Database =========="
  echo ""

  # Count before
  local before_obs before_sums
  before_obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations;")
  before_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries;")

  info "Enabling foreign keys..."
  sqlite3 "$DB" "PRAGMA foreign_keys = ON;"

  info "Deleting orphaned observations..."
  sqlite3 "$DB" "
    PRAGMA foreign_keys = ON;
    DELETE FROM observations
    WHERE memory_session_id NOT IN (
      SELECT memory_session_id FROM sdk_sessions WHERE memory_session_id IS NOT NULL
    );
  "
  local deleted_obs=$((before_obs - $(sqlite3 "$DB" "SELECT COUNT(*) FROM observations;")))
  ok "Deleted $deleted_obs orphaned observations"

  info "Deleting orphaned session_summaries..."
  sqlite3 "$DB" "
    PRAGMA foreign_keys = ON;
    DELETE FROM session_summaries
    WHERE memory_session_id NOT IN (
      SELECT memory_session_id FROM sdk_sessions WHERE memory_session_id IS NOT NULL
    );
  "
  local deleted_sums=$((before_sums - $(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries;")))
  ok "Deleted $deleted_sums orphaned session_summaries"

  # Verify
  local after_orphan_obs after_orphan_sums
  after_orphan_obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations o LEFT JOIN sdk_sessions s ON s.memory_session_id = o.memory_session_id WHERE s.memory_session_id IS NULL;")
  after_orphan_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries ss LEFT JOIN sdk_sessions s ON s.memory_session_id = ss.memory_session_id WHERE s.memory_session_id IS NULL;")

  if [[ "$after_orphan_obs" -eq 0 && "$after_orphan_sums" -eq 0 ]]; then
    ok "Verification passed — 0 orphaned records remaining"
  else
    fail "Verification failed — remaining orphans: obs=$after_orphan_obs, summaries=$after_orphan_sums"
    return 1
  fi

  # Vacuum to reclaim space
  info "Vacuuming database..."
  local before_size=$(ls -lh "$DB" | awk '{print $5}')
  sqlite3 "$DB" "PRAGMA foreign_keys = ON; VACUUM;"
  local after_size=$(ls -lh "$DB" | awk '{print $5}')
  ok "Vacuum complete: ${before_size} → ${after_size}"

  echo ""
}

# ── Rebuild Chroma ───────────────────────────────────────────────────
rebuild_chroma() {
  echo ""
  printf "  ${BOLD}%s${RESET}\n" "========== Rebuilding Chroma =========="
  echo ""

  if [[ ! -f "$CHROMA_DB" ]]; then
    info "Chroma database not found — will be created on worker restart"
    return 0
  fi

  local before_size=$(ls -lh "$CHROMA_DB" | awk '{print $5}')
  local before_emb=$(sqlite3 "$CHROMA_DB" "SELECT COUNT(*) FROM embeddings;" 2>/dev/null || echo 0)

  stop_chroma

  info "Removing Chroma database..."
  rm -f "$CHROMA_DB"
  # Also remove WAL/SHM files
  rm -f "$CHROMA_DB-wal" "$CHROMA_DB-shm"
  ok "Chroma database removed (was: $before_size, $before_emb embeddings)"

  echo ""
  info "Chroma will be rebuilt on worker restart via backfillAllProjects()"
  info "This syncs all valid observations/summaries/prompts to vector DB"
  echo ""
}

# ── Verify after cleanup ─────────────────────────────────────────────
verify_cleanup() {
  echo ""
  printf "  ${BOLD}%s${RESET}\n" "========== Post-Cleanup Verification =========="
  echo ""

  local obs total_sums orphan_obs orphan_sums
  obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations;")
  total_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries;")
  orphan_obs=$(sqlite3 "$DB" "SELECT COUNT(*) FROM observations o LEFT JOIN sdk_sessions s ON s.memory_session_id = o.memory_session_id WHERE s.memory_session_id IS NULL;")
  orphan_sums=$(sqlite3 "$DB" "SELECT COUNT(*) FROM session_summaries ss LEFT JOIN sdk_sessions s ON s.memory_session_id = ss.memory_session_id WHERE s.memory_session_id IS NULL;")

  local db_size=$(ls -lh "$DB" | awk '{print $5}')

  printf "  %-30s %6s (orphan: %s)\n" "observations" "$obs" "$orphan_obs"
  printf "  %-30s %6s (orphan: %s)\n" "session_summaries" "$total_sums" "$orphan_sums"
  printf "  %-30s %6s\n" "Database size" "$db_size"

  if [[ -f "$CHROMA_DB" ]]; then
    local chroma_emb=$(sqlite3 "$CHROMA_DB" "SELECT COUNT(*) FROM embeddings;" 2>/dev/null || echo "?")
    printf "  %-30s %6s\n" "Chroma embeddings" "$chroma_emb"
  else
    printf "  %-30s (will be created on restart)\n" "Chroma"
  fi

  echo ""

  if [[ "$orphan_obs" -eq 0 && "$orphan_sums" -eq 0 ]]; then
    ok "All checks passed — database is clean"
  else
    fail "Orphaned records remain — manual investigation needed"
    return 1
  fi
}

# ── Main ─────────────────────────────────────────────────────────────

echo ""
printf "${BOLD}claude-mem Database Cleanup${RESET}\n"
printf "Database: ${DIM}%s${RESET}\n" "$DB"
printf "Mode: ${YELLOW}%s${RESET}\n" "$([[ "$DRY_RUN" == "true" ]] && echo 'DRY-RUN (no changes)' || echo 'LIVE')"
echo ""

# Show report always
show_report

if [[ "$DRY_RUN" == "true" ]]; then
  info "Dry-run complete — no changes made."
  echo ""
  exit 0
fi

# Confirmation
if [[ "$AUTO_YES" != "true" ]]; then
  printf "${YELLOW}Proceed with cleanup? This is IRREVERSIBLE.${RESET}\n"
  printf "Type ${BOLD}yes${RESET} to confirm: "
  read -r CONFIRM
  if [[ "$CONFIRM" != "yes" ]]; then
    info "Aborted — no changes made."
    echo ""
    exit 0
  fi
fi

# Execute
stop_worker
clean_main_db
rebuild_chroma
start_worker

# Give worker a moment to start Chroma backfill
echo ""
info "Waiting for worker to initialize Chroma backfill..."
sleep 5

verify_cleanup

echo ""
ok "Cleanup complete"
echo ""
