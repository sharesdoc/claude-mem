#!/usr/bin/env bash
set -euo pipefail

# adjust-old-client-data — 旧客户端数据修复工具
#
# 服务端升级 migration 40/41 后,未升级客户端 sync 时不报 completed_at_epoch,
# 落库为 NULL 导致 stats 统计为 0。此脚本用旧逻辑回填:
#   同一会话内,下一条的 created_at_epoch = 上一条的 completed_at_epoch
#   最后一条 → session.completed_at_epoch(有则用) / created_at + 5min(兜底)
#
# 用法: bash adjust-old-client-data -n "用户名"

DB_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
DB_PATH="$DB_DIR/claude-mem.db"
FALLBACK_MS=300000  # 5分钟,最后一条无 session time 时兜底

# ── CLI ────────────────────────────────────────────────────────────────────
NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) echo "用法: adjust-old-client-data -n \"用户名\""; exit 0 ;;
    -n|--name) NAME="${2:-}"; shift ;;
    *) echo "未知: $1"; exit 1 ;;
  esac
  shift
done

if [[ -z "$NAME" ]]; then
  echo "用法: adjust-old-client-data -n \"用户名\"" >&2
  exit 1
fi

echo "数据库: $DB_PATH"
echo "目标用户: $NAME"
echo ""

# ── 找到含 NULL prompt 的会话 ─────────────────────────────────────────────
SESSIONS=$(sqlite3 -separator $'\t' "$DB_PATH" "
  SELECT DISTINCT up.content_session_id,
         s.completed_at_epoch
  FROM user_prompts up
  JOIN sdk_sessions s ON s.content_session_id = up.content_session_id
  WHERE up.completed_at_epoch IS NULL
    AND COALESCE(NULLIF(s.user_label, ''), 'unknown') = '$NAME' COLLATE NOCASE
")

if [[ -z "$SESSIONS" ]]; then
  echo "该用户没有需要修复的 NULL completed_at_epoch 记录。"
  exit 0
fi

SESS_COUNT=$(echo "$SESSIONS" | grep -c .)
echo "找到 $SESS_COUNT 个含 NULL prompt 的会话"

TOTAL_FIXED=0
FALLBACK_LAST=0

# ── 逐会话处理 ────────────────────────────────────────────────────────────
while IFS=$'\t' read -r sid sess_completed; do
  [[ -z "$sid" ]] && continue

  # 该会话所有 prompt(含已完成的),按 prompt_number 排序
  ALL_PNS=$(sqlite3 -separator $'\t' "$DB_PATH" "
    SELECT prompt_number, created_at_epoch
    FROM user_prompts
    WHERE content_session_id = '$sid'
    ORDER BY prompt_number ASC
  ")

  # 构建 "下一条 created_at_epoch" 映射: 用 awk 做 lag
  NEXT_MAP=$(echo "$ALL_PNS" | awk -F$'\t' '
    { pn[NR]=$1; cr[NR]=$2 }
    END { for(i=1;i<NR;i++) print pn[i]"\t"cr[i+1] }
  ')

  # 最后一条 prompt_number
  LAST_PN=$(echo "$ALL_PNS" | tail -1 | cut -f1)

  # 处理该会话中 completed_at_epoch IS NULL 的 prompt
  NULL_PNS=$(sqlite3 -separator $'\t' "$DB_PATH" "
    SELECT prompt_number, created_at_epoch
    FROM user_prompts
    WHERE content_session_id = '$sid' AND completed_at_epoch IS NULL
    ORDER BY prompt_number ASC
  ")

  FIXED=0
  while IFS=$'\t' read -r pn created; do
    [[ -z "$pn" ]] && continue

    # 查下一条 created
    NEXT_CREATED=$(echo "$NEXT_MAP" | awk -F$'\t' -v pn="$pn" '$1==pn{print $2}')

    if [[ -n "$NEXT_CREATED" ]]; then
      # 有下一条 → 用下一条的 created_at_epoch
      NEW_COMPLETED=$NEXT_CREATED
    elif [[ -n "$sess_completed" && "$sess_completed" != "null" ]]; then
      # 最后一条,有 session time
      NEW_COMPLETED=$sess_completed
    else
      # 兜底
      NEW_COMPLETED=$((created + FALLBACK_MS))
      FALLBACK_LAST=$((FALLBACK_LAST + 1))
    fi

    # 防止负数
    (( NEW_COMPLETED < created )) && NEW_COMPLETED=$created

    sqlite3 "$DB_PATH" "
      UPDATE user_prompts SET completed_at_epoch = $NEW_COMPLETED
      WHERE content_session_id = '$sid' AND prompt_number = $pn
    "
    FIXED=$((FIXED + 1))
  done <<<"$NULL_PNS"

  TAG=""
  [[ -z "$sess_completed" || "$sess_completed" = "null" ]] && TAG=" (5min兜底)"
  echo "  ${sid:0:8}…: $FIXED 个 NULL prompt,已回填 $FIXED 条${TAG}"
  TOTAL_FIXED=$((TOTAL_FIXED + FIXED))
done <<<"$SESSIONS"

echo ""
echo "===== 完成 ====="
echo "修复: $TOTAL_FIXED 条 prompt"
(( FALLBACK_LAST > 0 )) && echo "其中 $FALLBACK_LAST 条为最后一条(5min 兜底,因会话未正常结束)"
