{
  "description": "Codex task timer hooks. UserPromptSubmit starts a task, PostToolUse updates activity, and Stop closes it.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}/hooks/codex-turn-timer.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}/hooks/codex-turn-timer.py",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}/hooks/codex-turn-timer.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
