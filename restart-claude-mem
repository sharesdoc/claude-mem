#!/usr/bin/env bash
set -euo pipefail

# restart-claude-mem — restart all installed claude-mem workers
# Preserves all configuration and data. No changes to settings.json or database.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
info() { printf "  ${BLUE}→${RESET} %s\n" "$1"; }
step() { printf "\n${BOLD}%s${RESET}\n" "$1"; }

DATA_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
MARKETPLACE_DIR="$HOME/.claude/plugins/marketplaces/thedotmack"
WORKER_SCRIPT="$MARKETPLACE_DIR/plugin/scripts/worker-service.cjs"
PID_FILE="$DATA_DIR/worker.pid"

# ── Help ───────────────────────────────────────────────────────────────
show_help() {
  printf "${BOLD}claude-mem restart${RESET} — stop and restart the local worker.\n\n"
  printf "${BOLD}Usage:${RESET}\n"
  printf "  ./restart-claude-mem            Restart worker (preserves config & data)\n"
  printf "  ./restart-claude-mem -h|--help  Show this help message\n\n"
  printf "${BOLD}When to use:${RESET}\n"
  printf "  After editing ${DIM}%s/settings.json${RESET}\n" "$DATA_DIR"
  printf "  (role / token / CORS / bind host etc.) so the worker re-reads them.\n"
  printf "  Settings and database are never touched by this script.\n\n"
  printf "${BOLD}Environment:${RESET}\n"
  printf "  ${DIM}CLAUDE_MEM_DATA_DIR${RESET}  Override data dir (default: ~/.claude-mem)\n\n"
}

# ── Parse args ─────────────────────────────────────────────────────────
case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') ;;
  *) fail "Unknown argument: $1"; printf "\n"; show_help; exit 1 ;;
esac

# ── Locate worker script ───────────────────────────────────────────────
if [[ ! -f "$WORKER_SCRIPT" ]]; then
  # Try versioned cache
  WORKER_SCRIPT=$(ls -t "$HOME/.claude/plugins/cache/thedotmack/claude-mem/"*/scripts/worker-service.cjs 2>/dev/null | head -1 || true)
  if [[ -z "$WORKER_SCRIPT" ]]; then
    fail "Worker script not found. Is claude-mem installed?"
    exit 1
  fi
fi

# ── Require bun ────────────────────────────────────────────────────────
if ! command -v bun &>/dev/null; then
  for candidate in "$HOME/.bun/bin/bun" "/usr/local/bin/bun"; do
    if [[ -x "$candidate" ]]; then
      export PATH="$HOME/.bun/bin:$PATH"
      break
    fi
  done
  if ! command -v bun &>/dev/null; then
    fail "bun not found — install it first: https://bun.sh"
    exit 1
  fi
fi

# ── Get worker port ────────────────────────────────────────────────────
get_worker_port() {
  if [[ -f "$PID_FILE" ]]; then
    local port
    port=$(grep -o '"port":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$port" ]]; then
      echo "$port"
      return
    fi
  fi
  if [[ -f "$DATA_DIR/settings.json" ]]; then
    local sport
    sport=$(grep -o '"CLAUDE_MEM_WORKER_PORT":[[:space:]]*"[0-9]*"' "$DATA_DIR/settings.json" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$sport" ]]; then
      echo "$sport"
      return
    fi
  fi
  echo "$(( 37700 + $(id -u) % 100 ))"
}

check_worker_running() {
  local port
  port=$(get_worker_port)
  curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 2 2>/dev/null
}

# ── Main ───────────────────────────────────────────────────────────────
printf "\n${BOLD}${BLUE}claude-mem — Restart${RESET}\n"
printf "${DIM}Data dir: %s${RESET}\n" "$DATA_DIR"

port=$(get_worker_port)

# 1) Stop
step "Stopping worker..."
if check_worker_running; then
  info "Worker is running on port ${port} — stopping..."
  bun "$WORKER_SCRIPT" stop >/dev/null 2>&1 || true
  sleep 2

  # Verify stopped
  if check_worker_running; then
    # Force stop via PID file
    if [[ -f "$PID_FILE" ]]; then
      pid=$(grep -o '"pid":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
      if [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1; then
        kill "$pid" 2>/dev/null || true
        sleep 2
        ps -p "$pid" >/dev/null 2>&1 && kill -9 "$pid" 2>/dev/null || true
      fi
    fi
    if check_worker_running; then
      fail "Worker could not be stopped"
      exit 1
    fi
  fi
  ok "Worker stopped"
else
  ok "Worker not running"
fi

# 2) Start
step "Starting worker..."
bun "$WORKER_SCRIPT" start >/dev/null 2>&1 || true

# Wait for health check. A cold worker boot (bun startup + DB init + migrations
# + SyncAgent) can exceed 15s on Windows/MSYS, so wait up to 30s to avoid a
# false "timed out" warning when the worker is simply still coming up.
retries=0
while [[ $retries -lt 30 ]]; do
  if curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 1 2>/dev/null; then
    ok "Worker started on port ${port}"
    break
  fi
  retries=$((retries + 1))
  sleep 1
done

if ! check_worker_running; then
  warn "Health check timed out — worker may still be starting"
fi

# 3) Summary
printf "\n${BOLD}─────────────────────────────────────────${RESET}\n"
printf "${BOLD} Restart Summary${RESET}\n"
printf "${BOLD}─────────────────────────────────────────${RESET}\n"
printf "  Port:       %s\n" "$port"
printf "  Data dir:   %s\n" "$DATA_DIR"
printf "  Config:     ${GREEN}preserved${RESET}\n"
printf "  Database:   ${GREEN}preserved${RESET}\n"
printf "\n"
printf "  ${DIM}Viewer:${RESET}  http://localhost:%s\n" "$port"
printf "  ${DIM}Health:${RESET}  http://localhost:%s/api/health\n" "$port"
printf "\n"

if check_worker_running; then
  ok "Restart complete"
else
  warn "Restart completed but worker is not responding"
fi
