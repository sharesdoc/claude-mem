# ── Sync settings writer (T-26) ─────────────────────────────────────
# Writes/merges role + upstream + user_label + api_key into
# $DATA_DIR/settings.json. Idempotent: re-running with the same flags
# is a no-op; running with different values updates them in place.
#
# Why a separate helper instead of inlining in do_install_*:
#   - both claude and codex installers share the same target file
#   - we want it to happen AFTER the worker has rendered its first
#     settings.json (defaults), so we only overlay sync keys.
apply_sync_settings() {
  local role="${1:-}"          # client | server | ''
  local upstream="${2:-}"
  local label="${3:-}"
  local api_key="${4:-}"
  local token="${5:-}"

  if [[ -z "$role" && -z "$upstream" && -z "$label" && -z "$api_key" && -z "$token" ]]; then
    return 0
  fi

  local file="$DATA_DIR/settings.json"
  mkdir -p "$DATA_DIR"
  if [[ ! -f "$file" ]]; then
    printf '{"env":{}}\n' > "$file"
  fi

  # Pre-compute JS-safe string-or-null values before the heredoc.
  # The old ${var:+\"$var\"}${var:-null} pattern was broken: when var is set,
  # BOTH branches expand, producing '"value"value' which is a JS syntax error.
  _js() { if [[ -n "$1" ]]; then printf '"%s"' "$1"; else printf null; fi; }
  local _role_js;    _role_js="$(_js "$role")"
  local _upstream_js; _upstream_js="$(_js "$upstream")"
  local _label_js;    _label_js="$(_js "$label")"
  local _apikey_js;   _apikey_js="$(_js "$api_key")"
  local _token_js;    _token_js="$(_js "$token")"

  step "Applying sync settings"
  # Worker canonicalizes settings.json to FLAT (no env wrapper) on load.
  # If we write nested env here, the worker's auto-migration silently
  # drops any pre-existing top-level keys. So normalise to flat up-front.
  node - <<EOF
const fs = require('fs');
const path = '$file';
let raw = {};
try { raw = JSON.parse(fs.readFileSync(path, 'utf-8')); } catch (e) { raw = {}; }
let flat = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
if (flat.env && typeof flat.env === 'object') {
  flat = { ...flat, ...flat.env };
  delete flat.env;
}

const role = ${_role_js};
const upstream = ${_upstream_js};
const label = ${_label_js};
const apiKey = ${_apikey_js};
const token = ${_token_js};

if (role) {
  flat.CLAUDE_MEM_NODE_ROLE = role;
  if (role === 'server') {
    if (!flat.CLAUDE_MEM_SERVER_BIND_HOST) flat.CLAUDE_MEM_SERVER_BIND_HOST = '0.0.0.0';
    if (!flat.CLAUDE_MEM_SERVER_TRUSTED_PROXIES) flat.CLAUDE_MEM_SERVER_TRUSTED_PROXIES = '127.0.0.1/32,::1/128,192.168.0.0/24';
  }
}
if (upstream) {
  flat.CLAUDE_MEM_SYNC_UPSTREAM_URL = upstream;
  if (!flat.CLAUDE_MEM_SYNC_ENABLED) flat.CLAUDE_MEM_SYNC_ENABLED = 'true';
}
if (label) flat.CLAUDE_MEM_USER_LABEL = label;
if (apiKey) {
  flat.CLAUDE_MEM_SYNC_API_KEY = apiKey;
  flat.CLAUDE_MEM_SYNC_AUTH_MODE = 'apikey';
}
if (token) {
  flat.CLAUDE_MEM_SYNC_ACCESS_TOKEN = token;
  flat.CLAUDE_MEM_SERVER_ACCESS_TOKEN = token;
}

fs.writeFileSync(path, JSON.stringify(flat, null, 2) + '\n');
console.log(' ✓ settings.json updated');
EOF

  if [[ "$role" == "server" ]]; then
    info "Server mode: bind=0.0.0.0"
  fi
  if [[ "$role" == "client" && -z "$upstream" ]]; then
    warn "client mode without --upstream: SyncAgent will not start until you set CLAUDE_MEM_SYNC_UPSTREAM_URL"
  fi
}

# Write CLAUDE_MEM_SERVER_ALLOWED_ORIGINS (csv) into settings.json so the
# CORS middleware lets public-domain viewers (frpc/nginx reverse-proxied)
# through. Empty arg = no-op.
apply_allowed_origins() {
  local origins="${1:-}"
  [[ -z "$origins" ]] && return 0
  local file="$DATA_DIR/settings.json"
  mkdir -p "$DATA_DIR"
  [[ -f "$file" ]] || printf '{}\n' > "$file"

  step "Applying allowed CORS origins"
  node - <<EOF
const fs = require('fs');
const path = '$file';
let raw = {};
try { raw = JSON.parse(fs.readFileSync(path, 'utf-8')); } catch (e) { raw = {}; }
let flat = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
if (flat.env && typeof flat.env === 'object') {
  flat = { ...flat, ...flat.env };
  delete flat.env;
}
flat.CLAUDE_MEM_SERVER_ALLOWED_ORIGINS = '$origins';
fs.writeFileSync(path, JSON.stringify(flat, null, 2) + '\n');
console.log(' ✓ allowed origins set:', '$origins');
EOF
}

# Print a clear warning when -i wrote new settings but the worker
# was already running, so the user knows to restart manually.
# Args: $1=worker-was-running-before-install ("1" or "")
#       $2=settings-flags-were-passed       ("1" or "")
warn_worker_needs_restart() {
  local was_running="${1:-}"
  local had_changes="${2:-}"
  [[ "$was_running" == "1" && "$had_changes" == "1" ]] || return 0
  printf "\n${YELLOW}${BOLD}⚠ Settings updated but worker is still running with the OLD config.${RESET}\n"
  printf "  ${YELLOW}Login / role / admin-password changes will NOT take effect until restart.${RESET}\n"
  printf "  ${BOLD}Run one of:${RESET}\n"
  printf "    ${BOLD}./install-claude-mem -r %s${RESET}   ${DIM}(reinstall, preserves data)${RESET}\n" "${3:-claude}"
  printf "    ${BOLD}./restart-claude-mem${RESET}             ${DIM}(just restart worker)${RESET}\n\n"
}

# ── Admin password ───────────────────────────────────────────────────
apply_admin_password() {
  local password="${1:-}"
  if [[ -z "$password" ]]; then return 0; fi

  local file="$DATA_DIR/settings.json"
  mkdir -p "$DATA_DIR"
  if [[ ! -f "$file" ]]; then
    printf '{"env":{}}\n' > "$file"
  fi

  local hash
  hash="$(node -e "console.log(require('crypto').createHash('sha1').update(process.argv[1]).digest('hex'))" "$password" 2>/dev/null)" || true
  if [[ -z "$hash" ]]; then
    hash="$(printf '%s' "$password" | openssl sha1 2>/dev/null | awk '{print $NF}')" || true
  fi
  if [[ -z "$hash" ]]; then
    fail "Could not hash admin password (need node or openssl)"
    return 1
  fi

  step "Setting admin password"

  # Always write flat to match the worker's canonical schema (see comment
   # in apply_sync_settings).
  node - <<ENDNODE
const fs = require('fs');
const path = '$file';
let raw = {};
try { raw = JSON.parse(fs.readFileSync(path, 'utf-8')); } catch (e) { raw = {}; }
let flat = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
if (flat.env && typeof flat.env === 'object') {
  flat = { ...flat, ...flat.env };
  delete flat.env;
}
flat.CLAUDE_MEM_ADMIN_PASSWORD = '$hash';
delete flat.CLAUDE_MEM_ADMIN_LOCKED;
fs.writeFileSync(path, JSON.stringify(flat, null, 2) + '\\n');
console.log(' ✓ admin password set (SHA1: $hash)');
ENDNODE

  # Clear login attempts to reset rate limit
  local db="$DATA_DIR/claude-mem.db"
  if [[ -f "$db" ]]; then
    sqlite3 "$db" "DELETE FROM admin_login_attempts;" 2>/dev/null || true
  fi

  ok "Admin password updated & account unlocked"
}

# ── Chroma vector-search compatibility ──────────────────────────────
# chroma-mcp pulls in onnxruntime>=1.20 via uvx. That package no longer
# ships wheels for macOS Intel (macosx_10_16_x86_64) and only ships
# arm64 wheels for macOS 14+. We auto-disable Chroma on hosts where the
# install is guaranteed to fail and leave FTS5 search as the only path.
# Globals set:
#   CHROMA_COMPATIBLE — 1 (yes) or 0 (no)
#   CHROMA_REASON     — human-readable explanation, used in install summary
detect_chroma_compatibility() {
  CHROMA_COMPATIBLE=0
  CHROMA_REASON=""
  local os arch
  os="$(uname -s)"
  arch="$(uname -m)"
  case "$os" in
    Linux)
      CHROMA_COMPATIBLE=1
      CHROMA_REASON="Linux ${arch} — onnxruntime ships manylinux wheels"
      ;;
    Darwin)
      local ver major
      ver="$(sw_vers -productVersion 2>/dev/null || echo 0)"
      major="${ver%%.*}"
      if [[ "$arch" == "arm64" && "$major" -ge 14 ]]; then
        CHROMA_COMPATIBLE=1
        CHROMA_REASON="macOS ${ver} arm64 — onnxruntime ships macosx_14_0_arm64 wheels"
      elif [[ "$arch" == "arm64" ]]; then
        CHROMA_REASON="macOS ${ver} arm64 — onnxruntime arm64 wheels require macOS 14+"
      else
        CHROMA_REASON="macOS ${ver} Intel (${arch}) — onnxruntime no longer publishes Intel wheels"
      fi
      ;;
    *)
      CHROMA_REASON="${os} ${arch} — Chroma compatibility unverified, defaulting off"
      ;;
  esac
}

# Write CLAUDE_MEM_CHROMA_ENABLED to settings.json based on detection,
# overwriting any previous value. Always print the decision so the
# operator sees it in the install transcript. Also exports CHROMA_CHANGED
# (0/1) so the dispatcher can fold the change into _had_settings_changes
# and trigger warn_worker_needs_restart when a stale worker would still
# be using the old chroma mode in memory.
apply_chroma_default() {
  detect_chroma_compatibility
  local file="$DATA_DIR/settings.json"
  local enabled
  if [[ "$CHROMA_COMPATIBLE" == "1" ]]; then enabled="true"; else enabled="false"; fi

  # Compare against current value before writing, so we know whether a
  # restart is needed. An unset value defaults to enabled at runtime.
  local current=""
  if [[ -f "$file" ]]; then
    current="$(node -e "try{const s=require('$file');const e=s.env||s;console.log(e.CLAUDE_MEM_CHROMA_ENABLED||'')}catch(e){}" 2>/dev/null || true)"
  fi
  CHROMA_CHANGED="0"
  if [[ "$current" != "$enabled" ]]; then
    CHROMA_CHANGED="1"
  fi

  mkdir -p "$DATA_DIR"
  if [[ ! -f "$file" ]]; then
    printf '{}\n' > "$file"
  fi
  step "Configuring Chroma vector search"
  if [[ "$enabled" == "true" ]]; then
    ok "Chroma enabled — ${CHROMA_REASON}"
  else
    warn "Chroma disabled — ${CHROMA_REASON}"
    info "Full-text (FTS5) search remains available; only vector search is off."
    info "Override later: set CLAUDE_MEM_CHROMA_ENABLED=true in ${file}"
  fi
  # Worker canonicalizes settings.json to FLAT (no env wrapper) on load.
  # Writing nested env here would create a hybrid file whose top-level
  # keys (server role/token/admin) get dropped by the worker migration.
  # Match apply_sync_settings: normalise to flat before writing.
  node - <<EOF
const fs = require('fs');
const path = '$file';
let raw = {};
try { raw = JSON.parse(fs.readFileSync(path, 'utf-8')); } catch (e) { raw = {}; }
let flat = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
if (flat.env && typeof flat.env === 'object') {
  flat = { ...flat, ...flat.env };
  delete flat.env;
}
flat.CLAUDE_MEM_CHROMA_ENABLED = '$enabled';
fs.writeFileSync(path, JSON.stringify(flat, null, 2) + '\n');
EOF
}

# Print the final Chroma decision again at install end so it survives
# the wall of build/sync output that follows apply_chroma_default.
print_chroma_summary() {
  printf "\n${BOLD}Chroma:${RESET} "
  if [[ "${CHROMA_COMPATIBLE:-0}" == "1" ]]; then
    printf "${GREEN}enabled${RESET}  (${DIM}%s${RESET})\n" "$CHROMA_REASON"
  else
    printf "${YELLOW}disabled${RESET} (${DIM}%s${RESET})\n" "$CHROMA_REASON"
    printf "  ${DIM}FTS5 full-text search still works.${RESET}\n"
  fi
}

print_processing_time_status() {
  local settings_file="$DATA_DIR/settings.json"
  local env_val="${CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME:-}"
  local file_val=""
  if [[ -f "$settings_file" ]]; then
    file_val="$(node -e "try{console.log(require('$settings_file').CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME||'')}catch(e){console.log('')}" 2>/dev/null || echo "")"
  fi

  local effective="${env_val:-${file_val:-false}}"
  printf "${BOLD}Prompt processing time display:${RESET} "
  if [[ "$effective" == "true" ]]; then
    printf "${GREEN}ON${RESET}"
  else
    printf "${YELLOW}OFF${RESET} (default)"
  fi
  printf "  ${DIM}(env CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME=%s, file: %s)${RESET}\n" \
    "${env_val:-(unset)}" "${file_val:-(unset)}"
  if [[ "$effective" != "true" ]]; then
    printf "  ${DIM}Enable: export CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME=true${RESET}\n"
    printf "  ${DIM}    or add \"CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME\": \"true\" to %s${RESET}\n" "$settings_file"
  fi
}

backfill_missing_settings() {
  local file="$DATA_DIR/settings.json"
  if [[ ! -f "$file" ]]; then return; fi

  node -e "
    const fs = require('fs');
    const file = process.argv[1];
    let raw = JSON.parse(fs.readFileSync(file, 'utf-8'));
    // Keys that should always exist with defaults
    const defaults = {
      CLAUDE_MEM_PROMPT_SHOW_PROCESSING_TIME: 'false',
      CLAUDE_MEM_THINK_TIME_CAP_MINUTES: '3',
    };
    let changed = false;
    for (const [k, v] of Object.entries(defaults)) {
      if (!(k in raw)) { raw[k] = v; changed = true; }
    }
    if (changed) {
      fs.writeFileSync(file, JSON.stringify(raw, null, 2) + '\n');
      console.log('  \x1b[2m→\x1b[0m Backfilled missing settings defaults');
    }
  " "$file" 2>/dev/null || true
}

# ── Server info generator ───────────────────────────────────────────
get_lan_ip() {
  # Collect all IPv4 addresses from every interface, then pick the best
  # one: 192.168.x.x preferred, then 10.x.x.x, then 172.16-31.x.x,
  # then any other non-loopback. "YOUR-SERVER-IP" only if nothing found.
  local all_ips=""

  if command -v ifconfig &>/dev/null; then
    all_ips="$(ifconfig 2>/dev/null | grep -oE 'inet (addr:)?[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | awk '{print $NF}')"
  elif command -v ip &>/dev/null; then
    all_ips="$(ip -4 addr show 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | awk '{print $2}' | cut -d/ -f1)"
  fi

  if [[ -z "$all_ips" ]]; then
    echo "YOUR-SERVER-IP"
    return
  fi

  # Prefer 192.168.x.x
  local pick
  pick="$(echo "$all_ips" | grep -m1 '^192\.168\.')"
  if [[ -n "$pick" ]]; then echo "$pick"; return; fi

  # Then 10.x.x.x
  pick="$(echo "$all_ips" | grep -m1 '^10\.')"
  if [[ -n "$pick" ]]; then echo "$pick"; return; fi

  # Then 172.[16-31].x.x
  pick="$(echo "$all_ips" | grep -m1 '^172\.')"
  if [[ -n "$pick" ]]; then echo "$pick"; return; fi

  # Any non-loopback
  pick="$(echo "$all_ips" | grep -v '^127\.' | head -1)"
  if [[ -n "$pick" ]]; then echo "$pick"; return; fi

  echo "YOUR-SERVER-IP"
}

generate_server_info_md() {
  # This function MUST NOT cause the script to exit (set -e is active).
  # All commands are guarded so the user always sees token + URL even
  # when optional steps (IP detection, file write) fail.
  #
  # Heredoc uses QUOTED delimiter ('SERVEREOF') so bash does NOT expand
  # backticks inside markdown code fences (```) as command substitution.
  # Dynamic values go through __PLACEHOLDER__ → sed after the heredoc.
  local token="$1"
  local port
  port="$(get_worker_port)" || true
  local ip
  ip="$(get_lan_ip)" || true

  local file="$SCRIPT_DIR/SERVER-INFO.md"
  local url="http://${ip}:${port}"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"

  cat > "$file" 2>/dev/null <<'SERVEREOF'
# claude-mem Server Info

> 生成时间：__TS__
> 此文件描述的是 **本机作为 server** 的接入信息，供其它客户端机器使用。
> 包含共享密钥，请妥善保管，不要提交到版本库。

## 本机角色

| 项目 | 值 |
|---|---|
| **本机角色** | `server`（已通过 `--role server` 安装） |
| **Server API URL** | `__URL__` |
| **Access Token** | `__TOKEN__` |

## 客户端机器接入命令（在其它机器上执行）

下面的 `--role client` 是给**其他要连接本 server 的机器**用的，不是本机的角色。
替换 `<用户名>` 为实际标识（如 `zhangsan`）：

```bash
./install-claude-mem -i claude \
  --role client \
  --upstream __URL__ \
  --label <用户名> \
  --token __TOKEN__
```

## 验证连通性

```bash
# 在客户端执行
curl -s -H "Authorization: Bearer __TOKEN__" "__URL__/api/sync/status"
```

返回 JSON 即表示连通成功。

## 安全提醒

- 此 token 是共享密钥，泄露后任何人都能向 server 推送数据
- 如需轮换 token，server 端改 `CLAUDE_MEM_SERVER_ACCESS_TOKEN`，所有客户端同步更新
- 建议将此文件移出共享目录或加密存储
SERVEREOF

  # Substitute placeholders with actual values.
  if [[ -s "$file" ]]; then
    sed "s|__URL__|${url}|g; s|__TOKEN__|${token}|g; s|__TS__|${ts}|g" \
      "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
  fi

  if [[ -s "$file" ]]; then
    ok "SERVER-INFO.md generated at $file"
  else
    warn "Could not write SERVER-INFO.md (check directory permissions)"
  fi

  # Token and URL are ALWAYS printed, regardless of file write success.
  echo ""
  printf "  ${BOLD}🔑 Access Token:${RESET}  ${GREEN}%s${RESET}\n" "$token"
  printf "  ${BOLD}🌐 Server URL:  ${RESET} ${BLUE}%s${RESET}\n" "$url"
  echo ""
  printf "  ${DIM}将以上信息发给每个需要接入的用户。${RESET}\n"
  if [[ -s "$file" ]]; then
    printf "  ${DIM}完整信息已写入 %s${RESET}\n" "$file"
  fi
}

# ── Info ────────────────────────────────────────────────────────────
show_info() {
  printf "\n${BOLD}${BLUE}claude-mem — Configuration${RESET}\n\n"

  local settings_file="$DATA_DIR/settings.json"
  local role="client"
  local label=""
  local upstream=""
  local token=""
  local has_admin_pw="no"

  if [[ -f "$settings_file" ]]; then
    node -e "
      const s = JSON.parse(require('fs').readFileSync('$settings_file','utf-8'));
      const e = s.env || s;
      console.log(JSON.stringify({
        role: (e.CLAUDE_MEM_NODE_ROLE || 'client').trim(),
        label: (e.CLAUDE_MEM_USER_LABEL || '').trim(),
        upstream: (e.CLAUDE_MEM_SYNC_UPSTREAM_URL || '').trim(),
        token: (e.CLAUDE_MEM_SYNC_ACCESS_TOKEN || e.CLAUDE_MEM_SERVER_ACCESS_TOKEN || '').trim(),
        admin_pw: !!(e.CLAUDE_MEM_ADMIN_PASSWORD),
      }));
    " 2>/dev/null
  fi > "$DATA_DIR/.info-tmp.json"

  if [[ -s "$DATA_DIR/.info-tmp.json" ]]; then
    role=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$DATA_DIR/.info-tmp.json','utf-8')).role)" 2>/dev/null || echo client)
    label=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$DATA_DIR/.info-tmp.json','utf-8')).label)" 2>/dev/null || echo '')
    upstream=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$DATA_DIR/.info-tmp.json','utf-8')).upstream)" 2>/dev/null || echo '')
    token=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$DATA_DIR/.info-tmp.json','utf-8')).token)" 2>/dev/null || echo '')
    has_admin_pw=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$DATA_DIR/.info-tmp.json','utf-8')).admin_pw?'yes':'no')" 2>/dev/null || echo no)
  fi
  rm -f "$DATA_DIR/.info-tmp.json"

  local port
  port=$(get_worker_port)

  local running="no"
  check_worker_running && running="yes"

  local version="unknown"
  [[ -f "$SCRIPT_DIR/package.json" ]] && version=$(node -p "require('$SCRIPT_DIR/package.json').version" 2>/dev/null || echo unknown)

  local db_path="$DATA_DIR/claude-mem.db"
  local db_size="N/A"
  local db_obs="N/A"
  local db_first="N/A"
  if [[ -f "$db_path" ]] && command -v sqlite3 >/dev/null 2>&1; then
    local raw_size
    raw_size=$(wc -c < "$db_path" 2>/dev/null || echo 0)
    if [[ "$raw_size" -gt 1073741824 ]]; then
      db_size="$(( (raw_size + 53687091) / 1073741824 )) GB"
    elif [[ "$raw_size" -gt 1048576 ]]; then
      db_size="$(( (raw_size + 52428) / 1048576 )) MB"
    else
      db_size="$(( (raw_size + 51) / 1024 )) KB"
    fi
    db_obs=$(sqlite3 "$db_path" "SELECT COUNT(*) FROM observations;" 2>/dev/null || echo 'N/A')
    db_first=$(sqlite3 "$db_path" "SELECT MIN(created_at) FROM observations;" 2>/dev/null || echo 'N/A')
  fi

  local uptime="N/A"
  if [[ "$running" == "yes" ]]; then
    local up_sec
    up_sec=$(curl -sf --connect-timeout 2 --max-time 3 "http://127.0.0.1:${port}/api/health" 2>/dev/null | node -e "const d=require('fs').readFileSync('/dev/stdin','utf-8');try{console.log(JSON.parse(d).uptime||'')}catch(e){}" 2>/dev/null || echo '')
    if [[ -n "$up_sec" && "$up_sec" =~ ^[0-9]+$ ]]; then
      local d h m s
      s=$up_sec
      d=$((s/86400)); s=$((s%86400))
      h=$((s/3600));  s=$((s%3600))
      m=$((s/60));    s=$((s%60))
      uptime="${d}d ${h}h ${m}m ${s}s"
    fi
  fi

  local token_display="(not set)"
  if [[ -n "$token" ]]; then
    token_display="${token:0:8}...${token: -4}"
  fi

  printf "  ${BOLD}%-20s${RESET} %s\n" "Role"        "$role"
  printf "  ${BOLD}%-20s${RESET} %s\n" "Label"       "${label:-(none)}"
  printf "  ${BOLD}%-20s${RESET} %s\n" "Worker port"  "$port"
  printf "  ${BOLD}%-20s${RESET} %s\n" "Worker"       "${running} (port ${port})"
  printf "  ${BOLD}%-20s${RESET} %s\n" "Uptime"       "$uptime"
  printf "  ${BOLD}%-20s${RESET} %s\n" "Version"      "$version"

  if [[ "$role" == "server" ]]; then
    local ip
    ip=$(get_lan_ip 2>/dev/null || echo 'unknown')
    printf "  ${BOLD}%-20s${RESET} %s\n" "Server URL"     "http://${ip}:${port}"
    printf "  ${BOLD}%-20s${RESET} %s\n" "Access token"   "${token:-(not set)}"
    printf "  ${BOLD}%-20s${RESET} %s\n" "Admin password" "$has_admin_pw"
  fi

  if [[ "$role" == "client" ]]; then
    printf "  ${BOLD}%-20s${RESET} %s\n" "Sync server URL" "${upstream:-(not set)}"
    printf "  ${BOLD}%-20s${RESET} %s\n" "Sync token"      "${token:-(not set)}"
    printf "  ${BOLD}%-20s${RESET} %s\n" "Token preview"   "$token_display"
  fi

  printf "  ${BOLD}%-20s${RESET} %s\n"   "Data dir"    "$DATA_DIR"
  printf "  ${BOLD}%-20s${RESET} %s\n"   "DB size"     "$db_size"
  printf "  ${BOLD}%-20s${RESET} %s\n"   "Observations" "$db_obs"
  printf "  ${BOLD}%-20s${RESET} %s\n"   "First obs"   "$db_first"

  if [[ "$role" == "client" && "$running" == "yes" ]]; then
    local sync_status
    sync_status=$(curl -sf --connect-timeout 2 --max-time 3 "http://127.0.0.1:${port}/api/sync/status" 2>/dev/null || echo '{}')
    local lag_total last_error failures
    lag_total=$(echo "$sync_status" | node -e "process.stdin.on('data',d=>{try{const j=JSON.parse(d);console.log(j.lag?.total??'?')}catch{}})" 2>/dev/null || echo '?')
    failures=$(echo "$sync_status" | node -e "process.stdin.on('data',d=>{try{const j=JSON.parse(d);console.log(j.consecutive_failures??0)}catch{}})" 2>/dev/null || echo '0')
    last_error=$(echo "$sync_status" | node -e "process.stdin.on('data',d=>{try{const j=JSON.parse(d);console.log(j.last_error||'')}catch{}})" 2>/dev/null || echo '')
    printf "  ${BOLD}%-20s${RESET} %s\n" "Sync lag"     "$lag_total items"
    printf "  ${BOLD}%-20s${RESET} %s\n" "Sync failures" "$failures"
    if [[ -n "$last_error" ]]; then
      printf "  ${BOLD}%-20s${RESET} %s\n" "Last sync error" "$last_error"
    fi
  fi

  printf "\n"
}

# ── Main ────────────────────────────────────────────────────────────

# 将 target 参数解析为标准数组。支持：
#   单值:    claude / codex
#   别名:    both / all  →  claude codex
#   逗号分隔: claude,codex  →  claude codex
# 输出: 以换行分隔的标准 target 列表（每个为 claude 或 codex）
resolve_targets() {
  local raw="${1:-}"
  local expanded=""
  case "$raw" in
    both|all) expanded="claude codex" ;;
    *)        expanded="$(echo "$raw" | tr ',' ' ')" ;;
  esac
  local validated=""
  for t in $expanded; do
    case "$t" in
      claude|codex) validated="$validated $t" ;;
      *)  fail "Unknown target: $t"; printf "\n"; show_help; exit 1 ;;
    esac
  done
  echo "$validated" | xargs
}

main() {
  local action=""
  local target=""
  local sync_role=""
  local sync_upstream=""
  local sync_label=""
  local sync_api_key=""
  local sync_token=""
  local reset_token=""
  local admin_password=""
  local allowed_origins=""
  local debug_mode=""

  # T-26: pull sync flags out of the argv first so the existing
  # action/target positional logic stays unchanged.
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role) sync_role="${2:-}"; shift 2 ;;
      --role=*) sync_role="${1#--role=}"; shift ;;
      --upstream) sync_upstream="${2:-}"; shift 2 ;;
      --upstream=*) sync_upstream="${1#--upstream=}"; shift ;;
      --label) sync_label="${2:-}"; shift 2 ;;
      --label=*) sync_label="${1#--label=}"; shift ;;
      --api-key) sync_api_key="${2:-}"; shift 2 ;;
      --api-key=*) sync_api_key="${1#--api-key=}"; shift ;;
      --token) sync_token="${2:-}"; shift 2 ;;
      --token=*) sync_token="${1#--token=}"; shift ;;
      --reset-token) reset_token="1"; shift ;;
      --admin-password) admin_password="${2:-}"; shift 2 ;;
      --admin-password=*) admin_password="${1#--admin-password=}"; shift ;;
      --allowed-origins) allowed_origins="${2:-}"; shift 2 ;;
      --allowed-origins=*) allowed_origins="${1#--allowed-origins=}"; shift ;;
      --debug) debug_mode="1"; DEBUG="1"; shift ;;
      --info) show_info; return ;;
      *) args+=("$1"); shift ;;
    esac
  done

  set -- "${args[@]:-}"
  action="${1:-}"
  local raw_target="${2:-}"
  local targets=()

  # Enable trace mode after all local vars are declared.
  if [[ -n "$debug_mode" ]]; then
    export DEBUG="1"
    set -x
    dbg "Debug mode enabled"
  fi

  # If sync flags were passed without an action, default to -i so a single
  # `--role client --upstream … --label …` invocation is enough.
  if [[ -z "$action" && (-n "$sync_role" || -n "$sync_upstream" || -n "$sync_label" || -n "$sync_api_key" || -n "$sync_token") ]]; then
    action="-i"
  fi

  # Default the client `--label` to the OS username when omitted.
  if [[ "$sync_role" == "client" && -z "$sync_label" ]]; then
    sync_label="$(whoami)"
  fi


  # Reinstall (-r) without explicit sync flags: read existing config
  # from settings.json so the user does not need to re-specify everything.
  if [[ "$action" == "-r" && -z "$sync_role" && -z "$sync_upstream" && -z "$sync_label" && -z "$sync_token" && -z "$sync_api_key" && -z "$allowed_origins" ]]; then
    if [[ -f "$DATA_DIR/settings.json" ]]; then
      sync_role="$(node -e "try{const c=require('"$DATA_DIR"/settings.json');const e=c.env||c;console.log(e.CLAUDE_MEM_NODE_ROLE||'')}catch(e){}" 2>/dev/null || true)"
      sync_upstream="$(node -e "try{const c=require('"$DATA_DIR"/settings.json');const e=c.env||c;console.log(e.CLAUDE_MEM_SYNC_UPSTREAM_URL||'')}catch(e){}" 2>/dev/null || true)"
      sync_label="$(node -e "try{const c=require('"$DATA_DIR"/settings.json');const e=c.env||c;console.log(e.CLAUDE_MEM_USER_LABEL||'')}catch(e){}" 2>/dev/null || true)"
      sync_token="$(node -e "try{const c=require('"$DATA_DIR"/settings.json');const e=c.env||c;console.log(e.CLAUDE_MEM_SYNC_ACCESS_TOKEN||e.CLAUDE_MEM_SERVER_ACCESS_TOKEN||'')}catch(e){}" 2>/dev/null || true)"
      allowed_origins="$(node -e "try{const c=require('"$DATA_DIR"/settings.json');const e=c.env||c;console.log(e.CLAUDE_MEM_SERVER_ALLOWED_ORIGINS||'')}catch(e){}" 2>/dev/null || true)"
      if [[ -n "$sync_role" ]]; then
        ok "Reinstalling with preserved config (role=$sync_role, label=${sync_label:-?})"
      fi
    fi
  fi
  # Server mode: preserve existing access token on reinstall, regenerate
  # only on first install or when --reset-token is explicitly passed.
  if [[ "$sync_role" == "server" && -z "$sync_token" ]]; then
    if [[ -z "$reset_token" && -f "$DATA_DIR/settings.json" ]]; then
      # Reuse existing token so connected clients don't break.
      # Use node to read JSON safely (avoids grep/sed encoding issues
      # and pipefail + command-substitution bugs in macOS bash 3.2).
      sync_token="$(node -e "
try {
  const raw = require('fs').readFileSync('$DATA_DIR/settings.json','utf-8');
  const data = JSON.parse(raw);
  const env = data.env || data;
  const t = env.CLAUDE_MEM_SERVER_ACCESS_TOKEN || '';
  if (t) console.log(t);
} catch(e) {}" 2>/dev/null || true)"
      if [[ -n "$sync_token" ]]; then
        ok "Reusing existing access token (use --reset-token to regenerate)"
      fi
    fi
    if [[ -z "$sync_token" ]]; then
      sync_token="$(node -e "console.log(require('crypto').randomBytes(20).toString('hex'))" 2>/dev/null)"
      if [[ -z "$sync_token" ]]; then
        sync_token="$(openssl rand -hex 20 2>/dev/null || echo "change-me-$(date +%s)")"
      fi
    fi
  fi

  # Server mode: default admin password to the access token when not
  # explicitly overridden. This way the same credential secures both
  # sync and the viewer login without the operator needing to remember
  # a second secret.
  if [[ "$sync_role" == "server" && -z "$admin_password" && -n "$sync_token" ]]; then
    admin_password="$sync_token"
    dbg "Defaulting admin password to access token"
  fi

  # Standalone --admin-password (no install action needed)
  if [[ -z "$action" && -n "$admin_password" ]]; then
    apply_admin_password "$admin_password"
    return
  fi

  # No args → help
  if [[ -z "$action" ]]; then
    show_help
    return
  fi

  case "$action" in
    -h|--help)
      show_help
      ;;
    -i)
      if [[ -z "$raw_target" ]]; then
        fail "Missing target. Use: -i claude, -i codex, or -i both"
        exit 1
      fi
      targets=($(resolve_targets "$raw_target"))
      # Snapshot pre-install worker state + whether any settings flags
      # were passed, so we can warn the user after install if their new
      # config is sitting on disk but a stale worker is still running.
      local _had_settings_changes=""
      if [[ -n "$sync_role$sync_upstream$sync_label$sync_api_key$sync_token$admin_password$allowed_origins" ]]; then
        _had_settings_changes="1"
      fi
      local _worker_was_running=""
      check_worker_running && _worker_was_running="1"
      # 共享设置只应用一次（worker/Chroma/sync/admin）
      apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
      apply_admin_password "$admin_password"
      apply_allowed_origins "$allowed_origins"
      apply_chroma_default
      [[ "${CHROMA_CHANGED:-0}" == "1" ]] && _had_settings_changes="1"
      backfill_missing_settings
      # 逐个目标执行安装
      for target in "${targets[@]}"; do
        case "$target" in
          claude) do_install_claude ;;
          codex)  do_install_codex ;;
        esac
      done
      [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token"
      print_chroma_summary
      print_processing_time_status
      warn_worker_needs_restart "$_worker_was_running" "$_had_settings_changes" "$raw_target"
      ;;
    -u)
      if [[ -z "$raw_target" ]]; then
        fail "Missing target. Use: -u claude, -u codex, or -u both"
        exit 1
      fi
      targets=($(resolve_targets "$raw_target"))
      for target in "${targets[@]}"; do
        case "$target" in
          claude) do_uninstall_claude ;;
          codex)  do_uninstall_codex ;;
        esac
      done
      ;;
    -r)
      if [[ -z "$raw_target" ]]; then
        fail "Missing target. Use: -r claude, -r codex, or -r both"
        exit 1
      fi
      targets=($(resolve_targets "$raw_target"))
      # 先卸载所有目标
      for target in "${targets[@]}"; do
        case "$target" in
          claude) do_uninstall_claude ;;
          codex)  do_uninstall_codex ;;
        esac
      done
      # 共享设置只应用一次
      apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
      apply_admin_password "$admin_password"
      apply_allowed_origins "$allowed_origins"
      apply_chroma_default
      # 逐个目标重新安装
      for target in "${targets[@]}"; do
        case "$target" in
          claude) do_install_claude ;;
          codex)  do_install_codex ;;
        esac
      done
      [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token"
      print_chroma_summary
      print_processing_time_status
      ;;
    -d)
      if [[ -z "$raw_target" ]]; then
        fail "Missing target. Use: -d claude, -d codex, or -d both"
        exit 1
      fi
      targets=($(resolve_targets "$raw_target"))
      for target in "${targets[@]}"; do
        case "$target" in
          claude) do_destroy_claude ;;
          codex)  do_destroy_codex ;;
        esac
      done
      ;;
    *)
      printf "${RED}Unknown option: %s${RESET}\n\n" "$action"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
