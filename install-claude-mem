#!/usr/bin/env bash
set -euo pipefail

# claude-mem installer — run from repository root
# Usage: ./install-claude-mem -i|-u|-r|-d <claude|codex>
#
# Data-preservation contract:
#   -i / -u / -r  NEVER touch $DATA_DIR (default ~/.claude-mem). Database,
#                 archives, logs, chroma collections all survive reinstalls.
#   -d            DOES delete $DATA_DIR (after typed YES confirmation).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MARKETPLACE_DIR="$HOME/.claude/plugins/marketplaces/thedotmack"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
KNOWN_MARKETPLACES="$HOME/.claude/plugins/known_marketplaces.json"
INSTALLED_PLUGINS="$HOME/.claude/plugins/installed_plugins.json"
DATA_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
PID_FILE="$DATA_DIR/worker.pid"
WORKER_SCRIPT="$MARKETPLACE_DIR/plugin/scripts/worker-service.cjs"
BUILT_MARKER="$SCRIPT_DIR/plugin/scripts/worker-service.cjs"
LOCAL_VERSION="$(node -p "require('$SCRIPT_DIR/package.json').version" 2>/dev/null || echo 13.2.0)"
PLUGIN_CACHE_DIR="$HOME/.claude/plugins/cache/thedotmack/claude-mem/$LOCAL_VERSION"

# ── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
info() { printf "  ${BLUE}→${RESET} %s\n" "$1"; }
step() { printf "\n${BOLD}%s${RESET}\n" "$1"; }

# ── Help ────────────────────────────────────────────────────────────
show_help() {
  printf "${BOLD}claude-mem installer${RESET} — run from the repository root.\n\n"
  printf "${BOLD}Usage:${RESET}\n"
  printf "  ./install-claude-mem -i <target>   Install\n"
  printf "  ./install-claude-mem -u <target>   Uninstall (plugin only — DATA preserved)\n"
  printf "  ./install-claude-mem -r <target>   Reinstall  (uninstall + install — DATA preserved)\n"
  printf "  ./install-claude-mem -d <target>   ${RED}Destroy${RESET} (uninstall + DELETE all data)\n\n"
  printf "${BOLD}Targets:${RESET}\n"
  printf "  claude                 Claude Code\n"
  printf "  codex                  Codex CLI\n\n"
  printf "${BOLD}Options:${RESET}\n"
  printf "  -h, --help             Show this help message\n"
  printf "  --role <client|server> Configure dual-mode sync identity (T-26)\n"
  printf "  --upstream <URL>       (client) URL of the sync server, e.g. https://mem.acme.com\n"
  printf "  --label <NAME>         Sync identity (defaults to whoami in client mode)\n"
  printf "  --api-key <KEY>        Cloud-mode API key; flips auth_mode=apikey\n"
  printf "  --token <TOKEN>        LAN shared access token (simpler than apiKey)\n\n"
  printf "${BOLD}Data preservation:${RESET}\n"
  printf "  ${DIM}-i / -u / -r never touch %s — DB, archives, chroma, logs all survive.${RESET}\n" "$DATA_DIR"
  printf "  ${DIM}-d explicitly deletes %s after a typed YES confirmation.${RESET}\n\n" "$DATA_DIR"
  printf "${BOLD}Examples:${RESET}\n"
  printf "  ./install-claude-mem -i claude     # Install for Claude Code\n"
  printf "  ./install-claude-mem -u claude     # Uninstall plugin (keep data)\n"
  printf "  ./install-claude-mem -r claude     # Reinstall (keep data)\n"
  printf "  ./install-claude-mem -d claude     # Full purge incl. ~/.claude-mem\n"
  printf "  ./install-claude-mem -i codex      # Install for Codex CLI\n"
  printf "  ./install-claude-mem -i claude --role client --upstream https://mem.acme.com --label ZhangSan\n"
  printf "  ./install-claude-mem -i claude --role server\n"
  printf "  ./install-claude-mem -i claude --role client --upstream http://192.168.1.100:37701 --label ZhangSan --token my-shared-secret\n\n"
  printf "${BOLD}Install flow:${RESET}\n"
  printf "  Auto-detects state → builds → syncs → registers → starts worker\n\n"
}

# ── Detection ───────────────────────────────────────────────────────
check_built() {
  [[ -f "$BUILT_MARKER" ]]
}

check_synced() {
  # Both marketplace AND versioned cache must be populated, otherwise a partial
  # sync (e.g. failed mid-run) would be falsely reported as "already synced".
  [[ -f "$WORKER_SCRIPT" ]] && [[ -f "$PLUGIN_CACHE_DIR/scripts/worker-service.cjs" ]]
}

check_marketplace_registered() {
  [[ -f "$KNOWN_MARKETPLACES" ]] && grep -q '"thedotmack"' "$KNOWN_MARKETPLACES" 2>/dev/null
}

check_plugin_enabled() {
  [[ -f "$CLAUDE_SETTINGS" ]] && grep -q 'claude-mem@thedotmack' "$CLAUDE_SETTINGS" 2>/dev/null
}

get_worker_port() {
  if [[ -f "$PID_FILE" ]]; then
    local port
    port=$(grep -o '"port":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$port" ]]; then
      echo "$port"
      return
    fi
  fi
  if [[ -f "$DATA_DIR/settings.json" ]]; then
    local sport
    sport=$(grep -o '"CLAUDE_MEM_WORKER_PORT":[[:space:]]*"[0-9]*"' "$DATA_DIR/settings.json" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$sport" ]]; then
      echo "$sport"
      return
    fi
  fi
  echo "$(( 37700 + $(id -u) % 100 ))"
}

check_worker_running() {
  local port
  port=$(get_worker_port)
  curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 2 2>/dev/null
}

check_codex_cli() {
  command -v codex &>/dev/null
}

check_codex_plugin() {
  check_codex_cli && codex plugin list 2>/dev/null | grep -q 'claude-mem'
}

# ── tree-sitter binary handling (local-first, proxy fallback) ───────
# tree-sitter-cli@0.26.x postinstall fetches a ~7MB gz from github.com release
# CDN and hard-wires the URL. To avoid this fragile download we skip its
# postinstall (by removing from trustedDependencies) and inject the binary
# ourselves. Source preference:
#   1. ./download/tree-sitter-macos-<arch>.gz  in this repo
#   2. Prompt for SOCKS5 proxy port → curl --socks5-hostname download

case "$(uname -s)" in
  Darwin) TS_OS="macos" ;;
  Linux)  TS_OS="linux" ;;
  *) TS_OS="" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) TS_ARCH="x64" ;;
  arm64|aarch64) TS_ARCH="arm64" ;;
  *) TS_ARCH="" ;;
esac
LOCAL_TS_BINARY_GZ="$SCRIPT_DIR/download/tree-sitter-${TS_OS}-${TS_ARCH}.gz"

# Files we'll patch in-place (and restore) during sync.
PKGJSON_BACKUPS=()

ensure_treesitter_binary() {
  if [[ -z "$TS_OS" || -z "$TS_ARCH" ]]; then
    fail "Unsupported platform: $(uname -s)/$(uname -m)"
    exit 1
  fi

  if [[ -f "$LOCAL_TS_BINARY_GZ" ]]; then
    ok "Using local tree-sitter binary: $LOCAL_TS_BINARY_GZ"
    return
  fi

  warn "Local tree-sitter binary not found: $LOCAL_TS_BINARY_GZ"
  info "Will download via SOCKS5 proxy. Provide your local proxy port."
  printf "  SOCKS5 port [default 7890]: "
  local user_port
  read -r user_port
  user_port="${user_port:-7890}"

  if ! curl -sf --connect-timeout 3 --socks5-hostname "127.0.0.1:$user_port" \
       https://github.com -o /dev/null 2>/dev/null; then
    fail "SOCKS5 proxy at 127.0.0.1:$user_port not reachable"
    exit 1
  fi

  # Determine tree-sitter-cli version pinned in plugin/package.json (most
  # specific) — falls back to a known recent version if parsing fails.
  local ts_version
  ts_version="$(node -p "
    const v = require('$SCRIPT_DIR/plugin/package.json').dependencies['tree-sitter-cli'];
    v.replace(/^[^0-9]+/, '');
  " 2>/dev/null || echo '0.26.8')"

  local url="https://github.com/tree-sitter/tree-sitter/releases/download/v${ts_version}/tree-sitter-${TS_OS}-${TS_ARCH}.gz"
  mkdir -p "$SCRIPT_DIR/download"
  info "Downloading tree-sitter v${ts_version} via socks5://127.0.0.1:$user_port..."
  if curl -fL --socks5-hostname "127.0.0.1:$user_port" \
       --connect-timeout 10 --max-time 120 \
       -o "$LOCAL_TS_BINARY_GZ" "$url"; then
    ok "Downloaded to $LOCAL_TS_BINARY_GZ"
  else
    fail "Download failed from $url"
    rm -f "$LOCAL_TS_BINARY_GZ"
    exit 1
  fi
}

patch_pkgjson_skip_treesitter() {
  # Temporarily remove tree-sitter-cli from trustedDependencies so bun won't
  # run its postinstall (which hard-codes the github.com download URL).
  local f
  for f in "$SCRIPT_DIR/package.json" "$SCRIPT_DIR/plugin/package.json"; do
    [[ -f "$f" ]] || continue
    cp -p "$f" "${f}.install-bak"
    PKGJSON_BACKUPS+=("$f")
    local tmp
    tmp="$(mktemp)"
    jq '.trustedDependencies = ((.trustedDependencies // []) | map(select(. != "tree-sitter-cli")))' \
       "$f" > "$tmp"
    cat "$tmp" > "$f"
    rm -f "$tmp"
  done
  info "Disabled tree-sitter-cli postinstall in package.json (will restore after sync)"
}

restore_pkgjson() {
  local f
  for f in "${PKGJSON_BACKUPS[@]:-}"; do
    [[ -z "$f" ]] && continue
    if [[ -f "${f}.install-bak" ]]; then
      mv "${f}.install-bak" "$f"
    fi
  done
  PKGJSON_BACKUPS=()
}

inject_treesitter_binary() {
  local target_node_modules="$1"
  local ts_dir="$target_node_modules/tree-sitter-cli"
  if [[ ! -d "$ts_dir" ]]; then
    warn "tree-sitter-cli not in $target_node_modules — skip injection"
    return
  fi
  gunzip -c "$LOCAL_TS_BINARY_GZ" > "$ts_dir/tree-sitter"
  chmod +x "$ts_dir/tree-sitter"
  ok "Injected tree-sitter binary: $ts_dir/tree-sitter"
}

# Restore package.json files even if the script aborts mid-sync.
trap restore_pkgjson EXIT

# ── Local registration (no npx, no upstream fetch) ──────────────────
require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    fail "jq not found — required for local registration"
    info "Install: brew install jq"
    exit 1
  fi
}

json_patch() {
  # json_patch <file> <jq-filter>  — in-place update; creates {} if missing.
  # Symlink-safe: writes through the link via shell redirection (`>`) so a
  # symlinked settings.json keeps pointing at its real target after the patch.
  local file="$1"
  local filter="$2"
  local tmp
  tmp="$(mktemp)"
  mkdir -p "$(dirname "$file")"
  if [[ -f "$file" ]]; then
    jq "$filter" "$file" > "$tmp"
  else
    echo '{}' | jq "$filter" > "$tmp"
  fi
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

register_plugin_local() {
  require_jq
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%S.000Z)"

  # 1) known_marketplaces.json — autoUpdate:false 防止 Claude Code 自动从 upstream 拉取覆盖
  json_patch "$KNOWN_MARKETPLACES" \
    ".\"thedotmack\" = {
       source: { source: \"github\", repo: \"thedotmack/claude-mem\" },
       installLocation: \"$MARKETPLACE_DIR\",
       lastUpdated: \"$now\",
       autoUpdate: false
     }"
  ok "Marketplace registered (autoUpdate=false → 不会被 upstream 覆盖)"

  # 2) installed_plugins.json
  json_patch "$INSTALLED_PLUGINS" \
    "(.version //= 2) | (.plugins //= {}) |
     .plugins[\"claude-mem@thedotmack\"] = [{
       scope: \"user\",
       installPath: \"$PLUGIN_CACHE_DIR\",
       version: \"$LOCAL_VERSION\",
       installedAt: \"$now\",
       lastUpdated: \"$now\"
     }]"
  ok "Plugin recorded (v$LOCAL_VERSION)"

  # 3) settings.json — 启用插件 + 禁用 Claude Code 内置 auto-memory
  json_patch "$CLAUDE_SETTINGS" \
    "(.enabledPlugins //= {}) |
     .enabledPlugins[\"claude-mem@thedotmack\"] = true |
     (.env //= {}) |
     .env.CLAUDE_CODE_DISABLE_AUTO_MEMORY = \"1\""
  ok "Plugin enabled in settings.json, auto-memory disabled"
}

unregister_plugin_local() {
  require_jq

  if [[ -f "$KNOWN_MARKETPLACES" ]]; then
    json_patch "$KNOWN_MARKETPLACES" 'del(.thedotmack)'
    ok "Marketplace entry removed"
  fi

  if [[ -f "$INSTALLED_PLUGINS" ]]; then
    json_patch "$INSTALLED_PLUGINS" 'del(.plugins."claude-mem@thedotmack")'
    ok "Plugin record removed"
  fi

  if [[ -f "$CLAUDE_SETTINGS" ]]; then
    json_patch "$CLAUDE_SETTINGS" 'del(.enabledPlugins."claude-mem@thedotmack")'
    ok "Plugin disabled in settings.json"
  fi
}

# ── Shared actions ──────────────────────────────────────────────────
do_build() {
  if check_built; then
    ok "Already built"
    return
  fi

  warn "Not built yet — $BUILT_MARKER not found"
  printf "  Run ${BOLD}npm run build${RESET} now? [Y/n] "
  read -r answer
  case "$answer" in
    n*|N*) fail "Build skipped — cannot continue"; exit 1 ;;
  esac

  step "Building claude-mem..."
  (cd "$SCRIPT_DIR" && npm run build)
  if check_built; then
    ok "Build complete"
  else
    fail "Build failed — check errors above"
    exit 1
  fi
}

do_sync() {
  step "Syncing to marketplace..."
  if check_synced; then
    ok "Already synced to $MARKETPLACE_DIR"
    return
  fi
  # sync-marketplace.cjs rsyncs into <cache>/<version>/ but won't mkdir its
  # parents — pre-create so a fresh-state install doesn't trip on first run.
  mkdir -p "$MARKETPLACE_DIR" "$PLUGIN_CACHE_DIR"

  # Make sure the tree-sitter binary is available locally BEFORE we run bun
  # install, then disable the network-dependent postinstall.
  ensure_treesitter_binary
  patch_pkgjson_skip_treesitter

  info "Running npm run sync-marketplace..."
  (cd "$SCRIPT_DIR" && npm run sync-marketplace)

  # Place the binary into both bun-install locations so smart-file-read can
  # actually call it. The marketplace dir runs at runtime; the versioned cache
  # is what Claude Code loads from `installed_plugins.json`.
  inject_treesitter_binary "$MARKETPLACE_DIR/node_modules"
  inject_treesitter_binary "$PLUGIN_CACHE_DIR/node_modules"
  restore_pkgjson
  if check_synced; then
    ok "Synced to marketplace"
  else
    fail "Sync failed"
    exit 1
  fi
}

do_start_worker() {
  step "Starting worker..."
  local port
  port=$(get_worker_port)

  if check_worker_running; then
    ok "Worker already running on port ${port}"
    return
  fi

  if [[ ! -f "$WORKER_SCRIPT" ]]; then
    fail "Worker script not found at $WORKER_SCRIPT"
    info "Run sync first: npm run sync-marketplace"
    return 1
  fi

  info "Starting local worker via bun..."
  bun "$WORKER_SCRIPT" start >/dev/null 2>&1 || true

  local retries=0
  while [[ $retries -lt 10 ]]; do
    if curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 1 2>/dev/null; then
      ok "Worker started on port ${port}"
      return
    fi
    retries=$((retries + 1))
    sleep 1
  done

  warn "Worker health check timed out — it may still be starting"
  info "Check status: bun $WORKER_SCRIPT status"
}

do_stop_worker() {
  step "Stopping worker..."
  if ! check_worker_running && [[ ! -f "$PID_FILE" ]]; then
    ok "Worker not running"
    return
  fi

  if [[ -f "$WORKER_SCRIPT" ]]; then
    info "Stopping worker via bun..."
    bun "$WORKER_SCRIPT" stop >/dev/null 2>&1 || true
  fi

  # Belt-and-braces: kill by PID file if still alive
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(grep -o '"pid":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1; then
      kill "$pid" 2>/dev/null || true
      sleep 1
      ps -p "$pid" >/dev/null 2>&1 && kill -9 "$pid" 2>/dev/null || true
    fi
  fi

  if check_worker_running; then
    warn "Worker may still be running"
  else
    ok "Worker stopped"
  fi
}

print_summary() {
  local label="$1"
  printf "\n"
  printf "${BOLD}─────────────────────────────────────────${RESET}\n"
  printf "${BOLD} %s${RESET}\n" "$label"
  printf "${BOLD}─────────────────────────────────────────${RESET}\n"

  check_built          && ok "Built"          || fail "Not built"
  check_synced         && ok "Synced"         || fail "Not synced"
  check_worker_running && ok "Worker running" || warn "Worker not running"
}

# ── Claude Code ─────────────────────────────────────────────────────
do_install_claude() {
  printf "\n${BOLD}${BLUE}claude-mem — Claude Code Install${RESET}\n\n"

  # Already fully installed? Short-circuit.
  if check_built && check_synced && check_marketplace_registered && check_plugin_enabled && check_worker_running; then
    local port; port=$(get_worker_port)
    ok "Claude Code integration already installed and running"
    printf "\n"
    printf "  ${DIM}Viewer:${RESET}  http://localhost:%s\n" "$port"
    printf "  ${DIM}Health:${RESET}  http://localhost:%s/api/health\n" "$port"
    printf "  ${DIM}Use -r claude to reinstall.${RESET}\n\n"
    return
  fi

  do_build
  do_sync

  step "Registering plugin with Claude Code (local-only, no npx)..."
  register_plugin_local

  do_start_worker

  print_summary "Claude Code — Install Summary"
  check_marketplace_registered && ok "Registered"  || fail "Not registered"
  check_plugin_enabled         && ok "Enabled"      || warn "Not enabled"

  local port; port=$(get_worker_port)
  printf "\n"
  printf "  ${DIM}Viewer:${RESET}  http://localhost:%s\n" "$port"
  printf "  ${DIM}Health:${RESET}  http://localhost:%s/api/health\n" "$port"
  printf "  ${DIM}Restart Claude Code to load the plugin.${RESET}\n\n"
}

do_uninstall_claude() {
  printf "\n${BOLD}${BLUE}claude-mem — Claude Code Uninstall${RESET}\n\n"

  do_stop_worker

  step "Unregistering plugin (local-only, no npx)..."
  unregister_plugin_local

  step "Removing marketplace and cache directories..."
  if [[ -d "$MARKETPLACE_DIR" ]]; then
    rm -rf "$MARKETPLACE_DIR" && ok "Removed $MARKETPLACE_DIR"
  fi
  if [[ -d "$HOME/.claude/plugins/cache/thedotmack" ]]; then
    rm -rf "$HOME/.claude/plugins/cache/thedotmack" && ok "Removed plugin cache"
  fi
  if [[ -d "$HOME/.claude/plugins/data/claude-mem-thedotmack" ]]; then
    rm -rf "$HOME/.claude/plugins/data/claude-mem-thedotmack" && ok "Removed plugin data"
  fi

  printf "\n"
  if check_marketplace_registered || check_plugin_enabled; then
    warn "Plugin may not be fully removed — check manually"
  else
    ok "Plugin fully unregistered"
  fi
  # Explicit reminder: we never touch the data dir during uninstall/reinstall.
  # The user's database, archives, chroma collections etc. survive untouched.
  if [[ -d "$DATA_DIR" ]]; then
    ok "Data preserved at ${DIM}$DATA_DIR${RESET} (use ${BOLD}-d${RESET} to fully purge)"
  fi
  printf "\n"
}

# ── Codex CLI ───────────────────────────────────────────────────────
do_install_codex() {
  printf "\n${BOLD}${BLUE}claude-mem — Codex CLI Install${RESET}\n\n"

  step "Checking Codex CLI..."
  if check_codex_cli; then
    ok "Codex CLI found: $(command -v codex)"
  else
    fail "Codex CLI not found"
    printf "\n"
    info "Install Codex CLI first:"
    printf "    npm install -g @openai/codex\n\n"
    exit 1
  fi

  # Already fully installed?
  if check_built && check_synced && check_codex_plugin && check_worker_running; then
    local port; port=$(get_worker_port)
    ok "Codex CLI integration already installed and running"
    printf "\n"
    printf "  ${DIM}Use -r codex to reinstall.${RESET}\n\n"
    return
  fi

  do_build
  do_sync

  step "Registering with Codex..."
  if check_codex_plugin; then
    ok "Plugin already registered with Codex"
  else
    info "Running codex plugin marketplace add..."
    (cd "$SCRIPT_DIR" && codex plugin marketplace add "$SCRIPT_DIR" 2>/dev/null) || true
    (cd "$SCRIPT_DIR" && codex plugin marketplace upgrade claude-mem-local 2>/dev/null) || true
    (cd "$SCRIPT_DIR" && codex features enable plugin_hooks 2>/dev/null) || true
    if check_codex_plugin; then
      ok "Registered with Codex"
    else
      warn "Manual registration may be needed"
      info "Run: codex plugin marketplace add $SCRIPT_DIR"
    fi
  fi

  do_start_worker

  print_summary "Codex CLI — Install Summary"
  check_codex_plugin && ok "Registered with Codex" || warn "Not registered"

  printf "\n"
  printf "  ${DIM}Restart Codex CLI to load the plugin.${RESET}\n\n"
}

# ── Full data purge ─────────────────────────────────────────────────
# Only -d triggers this. Lists every top-level entry inside $DATA_DIR and
# requires the user to type YES verbatim before we touch anything. Refuses
# to run if it can't even list the dir (e.g. permissions) so we don't claim
# success on a partial wipe.
do_purge_data() {
  step "Purging persistent data..."

  if [[ ! -d "$DATA_DIR" ]]; then
    ok "No data directory at ${DIM}$DATA_DIR${RESET} — nothing to purge"
    return 0
  fi

  printf "  ${YELLOW}This will permanently delete the entire directory:${RESET}\n"
  printf "    ${BOLD}%s${RESET}\n\n" "$DATA_DIR"

  printf "  ${DIM}Top-level contents:${RESET}\n"
  if ! ls -la "$DATA_DIR" 2>/dev/null | tail -n +2 | awk 'NR>1 {
    size = $5;
    name = $NF;
    if (name == "." || name == "..") next;
    printf "    %-40s %s\n", name, size
  }'; then
    fail "Cannot enumerate $DATA_DIR — refusing to delete"
    return 1
  fi

  printf "\n  ${BOLD}${RED}This cannot be undone.${RESET}\n"
  printf "  Type ${BOLD}YES${RESET} (uppercase) to confirm full purge: "
  local answer
  read -r answer

  if [[ "$answer" != "YES" ]]; then
    warn "Purge cancelled (expected literal 'YES')"
    return 1
  fi

  # Refuse to rm -rf a path that's obviously not our data dir. Cheap guard
  # against a typo'd CLAUDE_MEM_DATA_DIR=/ or similar.
  case "$DATA_DIR" in
    /|/home|/root|/Users|/Users/*|"$HOME")
      fail "Refusing to delete suspicious path: $DATA_DIR"
      return 1
      ;;
  esac
  if [[ ! "$DATA_DIR" =~ \.claude-mem ]] && [[ -z "${CLAUDE_MEM_PURGE_FORCE:-}" ]]; then
    fail "DATA_DIR ($DATA_DIR) does not contain '.claude-mem'; set CLAUDE_MEM_PURGE_FORCE=1 to override"
    return 1
  fi

  rm -rf "$DATA_DIR" && ok "Removed $DATA_DIR"
}

do_destroy_claude() {
  printf "\n${BOLD}${RED}claude-mem — Claude Code FULL DESTROY${RESET}\n"
  printf "${DIM}This removes the plugin AND every byte of memory in %s.${RESET}\n" "$DATA_DIR"

  do_uninstall_claude
  do_purge_data
}

do_destroy_codex() {
  printf "\n${BOLD}${RED}claude-mem — Codex CLI FULL DESTROY${RESET}\n"
  printf "${DIM}This removes the plugin AND every byte of memory in %s.${RESET}\n" "$DATA_DIR"

  do_uninstall_codex
  do_purge_data
}

do_uninstall_codex() {
  printf "\n${BOLD}${BLUE}claude-mem — Codex CLI Uninstall${RESET}\n\n"

  if ! check_codex_cli; then
    fail "Codex CLI not found — nothing to uninstall"
    exit 1
  fi

  step "Unregistering from Codex..."
  if check_codex_plugin; then
    info "Removing claude-mem from Codex..."
    codex plugin marketplace remove claude-mem-local 2>/dev/null || true
    if check_codex_plugin; then
      warn "May need manual removal"
    else
      ok "Unregistered from Codex"
    fi
  else
    ok "Not registered — nothing to do"
  fi

  if [[ -d "$DATA_DIR" ]]; then
    ok "Data preserved at ${DIM}$DATA_DIR${RESET} (use ${BOLD}-d${RESET} to fully purge)"
  fi
  printf "\n"
}

# ── Sync settings writer (T-26) ─────────────────────────────────────
# Writes/merges role + upstream + user_label + api_key into
# $DATA_DIR/settings.json. Idempotent: re-running with the same flags
# is a no-op; running with different values updates them in place.
#
# Why a separate helper instead of inlining in do_install_*:
#   - both claude and codex installers share the same target file
#   - we want it to happen AFTER the worker has rendered its first
#     settings.json (defaults), so we only overlay sync keys.
apply_sync_settings() {
  local role="${1:-}"          # client | server | ''
  local upstream="${2:-}"
  local label="${3:-}"
  local api_key="${4:-}"
  local token="${5:-}"

  if [[ -z "$role" && -z "$upstream" && -z "$label" && -z "$api_key" && -z "$token" ]]; then
    return 0
  fi

  local file="$DATA_DIR/settings.json"
  mkdir -p "$DATA_DIR"
  if [[ ! -f "$file" ]]; then
    printf '{"env":{}}\n' > "$file"
  fi

  # Pre-compute JS-safe string-or-null values before the heredoc.
  # The old ${var:+\"$var\"}${var:-null} pattern was broken: when var is set,
  # BOTH branches expand, producing '"value"value' which is a JS syntax error.
  _js() { if [[ -n "$1" ]]; then printf '"%s"' "$1"; else printf null; fi; }
  local _role_js;    _role_js="$(_js "$role")"
  local _upstream_js; _upstream_js="$(_js "$upstream")"
  local _label_js;    _label_js="$(_js "$label")"
  local _apikey_js;   _apikey_js="$(_js "$api_key")"
  local _token_js;    _token_js="$(_js "$token")"

  step "Applying sync settings"
  node - <<EOF
const fs = require('fs');
const path = '$file';
let raw = {};
try { raw = JSON.parse(fs.readFileSync(path, 'utf-8')); } catch (e) { raw = {}; }
const env = raw.env && typeof raw.env === 'object' ? raw.env : (raw.env = {});

const role = ${_role_js};
const upstream = ${_upstream_js};
const label = ${_label_js};
const apiKey = ${_apikey_js};
const token = ${_token_js};

if (role) {
  env.CLAUDE_MEM_NODE_ROLE = role;
  if (role === 'server') {
    if (!env.CLAUDE_MEM_SERVER_BIND_HOST) env.CLAUDE_MEM_SERVER_BIND_HOST = '0.0.0.0';
    if (!env.CLAUDE_MEM_SERVER_TRUSTED_PROXIES) env.CLAUDE_MEM_SERVER_TRUSTED_PROXIES = '127.0.0.1/32,::1/128';
  }
}
if (upstream) {
  env.CLAUDE_MEM_SYNC_UPSTREAM_URL = upstream;
  if (!env.CLAUDE_MEM_SYNC_ENABLED) env.CLAUDE_MEM_SYNC_ENABLED = 'true';
}
if (label) env.CLAUDE_MEM_USER_LABEL = label;
if (apiKey) {
  env.CLAUDE_MEM_SYNC_API_KEY = apiKey;
  env.CLAUDE_MEM_SYNC_AUTH_MODE = 'apikey';
}
if (token) {
  env.CLAUDE_MEM_SYNC_ACCESS_TOKEN = token;
  env.CLAUDE_MEM_SERVER_ACCESS_TOKEN = token;
}

raw.env = env;
fs.writeFileSync(path, JSON.stringify(raw, null, 2) + '\n');
console.log(' ✓ settings.json updated');
EOF

  if [[ "$role" == "server" ]]; then
    info "Server mode: bind=0.0.0.0"
  fi
  if [[ "$role" == "client" && -z "$upstream" ]]; then
    warn "client mode without --upstream: SyncAgent will not start until you set CLAUDE_MEM_SYNC_UPSTREAM_URL"
  fi
}

# ── Server info generator ───────────────────────────────────────────
get_lan_ip() {
  if command -v ipconfig &>/dev/null; then
    local ip
    ip="$(ipconfig getifaddr en0 2>/dev/null)"
    if [[ -n "$ip" ]]; then echo "$ip"; return; fi
  fi
  if command -v hostname &>/dev/null; then
    local ip
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    if [[ -n "$ip" ]]; then echo "$ip"; return; fi
  fi
  echo "YOUR-SERVER-IP"
}

generate_server_info_md() {
  # This function MUST NOT cause the script to exit (set -e is active).
  # All commands are guarded so the user always sees token + URL even
  # when optional steps (IP detection, file write) fail.
  #
  # Heredoc uses QUOTED delimiter ('SERVEREOF') so bash does NOT expand
  # backticks inside markdown code fences (```) as command substitution.
  # Dynamic values go through __PLACEHOLDER__ → sed after the heredoc.
  local token="$1"
  local port
  port="$(get_worker_port)" || true
  local ip
  ip="$(get_lan_ip)" || true

  local file="$SCRIPT_DIR/SERVER-INFO.md"
  local url="http://${ip}:${port}"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"

  cat > "$file" 2>/dev/null <<'SERVEREOF'
# claude-mem Server Info

> 生成时间：__TS__
> 此文件包含客户端接入所需的关键信息，请妥善保管，不要提交到版本库。

## 接入信息

| 项目 | 值 |
|---|---|
| **Server API URL** | `__URL__` |
| **Access Token** | `__TOKEN__` |

## 客户端安装命令

在员工的电脑上执行（替换 `<员工名>` 为实际标识，如 `zhangsan`）：

```bash
./install-claude-mem -i claude \
  --role client \
  --upstream __URL__ \
  --label <员工名> \
  --token __TOKEN__
```

## 验证连通性

```bash
# 在客户端执行
curl -s -H "Authorization: Bearer __TOKEN__" "__URL__/api/sync/status"
```

返回 JSON 即表示连通成功。

## 安全提醒

- 此 token 是共享密钥，泄露后任何人都能向 server 推送数据
- 如需轮换 token，server 端改 `CLAUDE_MEM_SERVER_ACCESS_TOKEN`，所有客户端同步更新
- 建议将此文件移出共享目录或加密存储
SERVEREOF

  # Substitute placeholders with actual values.
  if [[ -s "$file" ]]; then
    sed "s|__URL__|${url}|g; s|__TOKEN__|${token}|g; s|__TS__|${ts}|g" \
      "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
  fi

  if [[ -s "$file" ]]; then
    ok "SERVER-INFO.md generated at $file"
  else
    warn "Could not write SERVER-INFO.md (check directory permissions)"
  fi

  # Token and URL are ALWAYS printed, regardless of file write success.
  echo ""
  echo "  ┌─────────────────────────────────────────────┐"
  printf "  │  🔑 Access Token:  %-25s │\n" "$token"
  printf "  │  🌐 Server URL:    %-25s │\n" "$url"
  echo "  └─────────────────────────────────────────────┘"
  echo ""
  printf "  ${DIM}将以上信息发给每个需要接入的员工。${RESET}\n"
  if [[ -s "$file" ]]; then
    printf "  ${DIM}完整信息已写入 %s${RESET}\n" "$file"
  fi
}

# ── Main ────────────────────────────────────────────────────────────
main() {
  local action=""
  local target=""
  local sync_role=""
  local sync_upstream=""
  local sync_label=""
  local sync_api_key=""
  local sync_token=""

  # T-26: pull sync flags out of the argv first so the existing
  # action/target positional logic stays unchanged.
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role) sync_role="${2:-}"; shift 2 ;;
      --role=*) sync_role="${1#--role=}"; shift ;;
      --upstream) sync_upstream="${2:-}"; shift 2 ;;
      --upstream=*) sync_upstream="${1#--upstream=}"; shift ;;
      --label) sync_label="${2:-}"; shift 2 ;;
      --label=*) sync_label="${1#--label=}"; shift ;;
      --api-key) sync_api_key="${2:-}"; shift 2 ;;
      --api-key=*) sync_api_key="${1#--api-key=}"; shift ;;
      --token) sync_token="${2:-}"; shift 2 ;;
      --token=*) sync_token="${1#--token=}"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done

  set -- "${args[@]}"
  action="${1:-}"
  target="${2:-}"

  # If sync flags were passed without an action, default to -i so a single
  # `--role client --upstream … --label …` invocation is enough.
  if [[ -z "$action" && (-n "$sync_role" || -n "$sync_upstream" || -n "$sync_label" || -n "$sync_api_key" || -n "$sync_token") ]]; then
    action="-i"
  fi

  # Default the client `--label` to the OS username when omitted.
  if [[ "$sync_role" == "client" && -z "$sync_label" ]]; then
    sync_label="$(whoami)"
  fi

  # Server mode: auto-generate an access token if the user didn't provide one.
  if [[ "$sync_role" == "server" && -z "$sync_token" ]]; then
    sync_token="$(node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))" 2>/dev/null)"
    if [[ -z "$sync_token" ]]; then
      # Fallback if node is unavailable during install
      sync_token="$(openssl rand -hex 16 2>/dev/null || echo "change-me-$(date +%s)")"
    fi
  fi

  # No args → help
  if [[ -z "$action" ]]; then
    show_help
    return
  fi

  case "$action" in
    -h|--help)
      show_help
      ;;
    -i)
      if [[ -z "$target" ]]; then
        fail "Missing target. Use: -i claude or -i codex"
        exit 1
      fi
      case "$target" in
        claude) do_install_claude; apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
                [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token" ;;
        codex)  do_install_codex;  apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
                [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token" ;;
        *)      fail "Unknown target: $target"; printf "\n"; show_help; exit 1 ;;
      esac
      ;;
    -u)
      if [[ -z "$target" ]]; then
        fail "Missing target. Use: -u claude or -u codex"
        exit 1
      fi
      case "$target" in
        claude) do_uninstall_claude ;;
        codex)  do_uninstall_codex ;;
        *)      fail "Unknown target: $target"; printf "\n"; show_help; exit 1 ;;
      esac
      ;;
    -r)
      if [[ -z "$target" ]]; then
        fail "Missing target. Use: -r claude or -r codex"
        exit 1
      fi
      case "$target" in
        claude) do_uninstall_claude; do_install_claude; apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
                [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token" ;;
        codex)  do_uninstall_codex;  do_install_codex;  apply_sync_settings "$sync_role" "$sync_upstream" "$sync_label" "$sync_api_key" "$sync_token"
                [[ "$sync_role" == "server" ]] && generate_server_info_md "$sync_token" ;;
        *)      fail "Unknown target: $target"; printf "\n"; show_help; exit 1 ;;
      esac
      ;;
    -d)
      if [[ -z "$target" ]]; then
        fail "Missing target. Use: -d claude or -d codex"
        exit 1
      fi
      case "$target" in
        claude) do_destroy_claude ;;
        codex)  do_destroy_codex ;;
        *)      fail "Unknown target: $target"; printf "\n"; show_help; exit 1 ;;
      esac
      ;;
    *)
      printf "${RED}Unknown option: %s${RESET}\n\n" "$action"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
