# ── Dependencies ─────────────────────────────────────────────────────
# Bun release naming: bun-<darwin|linux|windows>-<x64|aarch64>.zip
# (different from tree-sitter, which uses macos/arm64).
_detect_bun_archive() {
  local bun_os bun_arch
  case "$(uname -s)" in
    Darwin) bun_os="darwin" ;;
    Linux)  bun_os="linux"  ;;
    MINGW*|MSYS*|CYGWIN*) bun_os="windows" ;;
    *) return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) bun_arch="x64" ;;
    arm64|aarch64) bun_arch="aarch64" ;;
    *) return 1 ;;
  esac
  echo "$SCRIPT_DIR/download/bun-${bun_os}-${bun_arch}.zip"
}

# Install bun from a local zip in ./download. Mirrors the user-provided
# download/install-bun reference: unzip → copy to ~/.bun/bin → chmod +x →
# strip macOS quarantine attr → export PATH. Returns 0 on success.
_install_bun_from_local() {
  local zip="$1"
  if [[ ! -f "$zip" ]]; then return 1; fi
  if ! command -v unzip &>/dev/null; then
    warn "unzip not found — cannot use local $zip"
    return 1
  fi
  info "Using local bun archive: $zip"
  local tmp; tmp="$(mktemp -d)"
  if ! unzip -q "$zip" -d "$tmp"; then
    fail "Failed to extract $zip"
    rm -rf "$tmp"
    return 1
  fi
  local bun_bin; bun_bin="$(find "$tmp" -type f -name bun | head -1)"
  if [[ -z "$bun_bin" ]]; then
    fail "bun binary not found inside $zip"
    rm -rf "$tmp"
    return 1
  fi
  mkdir -p "$HOME/.bun/bin"
  cp "$bun_bin" "$HOME/.bun/bin/bun"
  chmod +x "$HOME/.bun/bin/bun"
  # macOS Gatekeeper quarantine prevents execution of binaries copied from
  # downloaded zips; strip it silently (no-op on non-macOS).
  xattr -d com.apple.quarantine "$HOME/.bun/bin/bun" 2>/dev/null || true
  rm -rf "$tmp"
  export PATH="$HOME/.bun/bin:$PATH"
  return 0
}

ensure_bun() {
  if command -v bun &>/dev/null; then return 0; fi

  step "Bun not found — auto-installing"
  # Respect user's existing bun install if it's just not on PATH
  for candidate in "$HOME/.bun/bin/bun" "/usr/local/bin/bun"; do
    if [[ -x "$candidate" ]]; then
      export PATH="$HOME/.bun/bin:$PATH"
      ok "Found bun at $candidate, added to PATH"
      return 0
    fi
  done

  # Prefer local archive — avoids network entirely on hosts behind a proxy
  # or offline. Falls through to the bun.sh installer when no matching
  # download/bun-<os>-<arch>.zip exists.
  local local_zip; local_zip="$(_detect_bun_archive || true)"
  if [[ -n "$local_zip" && -f "$local_zip" ]]; then
    if _install_bun_from_local "$local_zip" && command -v bun &>/dev/null; then
      ok "bun installed from local archive ($(bun --version))"
      return 0
    fi
    warn "Local archive install failed — falling back to network installer"
  elif [[ -n "$local_zip" ]]; then
    dbg "No local bun archive at $local_zip — will use network installer"
  fi

  info "Downloading and installing bun..."
  if command -v curl &>/dev/null; then
    curl -fsSL https://bun.sh/install | bash
  elif command -v wget &>/dev/null; then
    wget -qO- https://bun.sh/install | bash
  else
    fail "Need curl or wget to install bun. Install one of them and retry."
    exit 1
  fi

  export PATH="$HOME/.bun/bin:$PATH"
  if command -v bun &>/dev/null; then
    ok "bun installed successfully ($(bun --version))"
  else
    fail "bun installation completed but bun is still not on PATH"
    info "Try: export PATH=\"\$HOME/.bun/bin:\$PATH\" && bun --version"
    exit 1
  fi
}

# ── Detection ───────────────────────────────────────────────────────
check_built() {
  [[ -f "$BUILT_MARKER" ]]
}

check_synced() {
  # Both marketplace AND versioned cache must be populated, otherwise a partial
  # sync (e.g. failed mid-run) would be falsely reported as "already synced".
  [[ -f "$WORKER_SCRIPT" ]] && [[ -f "$PLUGIN_CACHE_DIR/scripts/worker-service.cjs" ]]
}

check_marketplace_registered() {
  [[ -f "$KNOWN_MARKETPLACES" ]] && grep -q '"thedotmack"' "$KNOWN_MARKETPLACES" 2>/dev/null
}

check_plugin_enabled() {
  [[ -f "$CLAUDE_SETTINGS" ]] && grep -q 'claude-mem@thedotmack' "$CLAUDE_SETTINGS" 2>/dev/null
}

get_worker_port() {
  dbg "get_worker_port: PID_FILE=$PID_FILE, settings=$DATA_DIR/settings.json"
  if [[ -f "$PID_FILE" ]]; then
    local port
    port=$(grep -o '"port":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$port" ]]; then
      dbg "get_worker_port: found port $port in PID file"
      echo "$port"
      return
    fi
  fi
  if [[ -f "$DATA_DIR/settings.json" ]]; then
    local sport
    sport=$(grep -o '"CLAUDE_MEM_WORKER_PORT":[[:space:]]*"[0-9]*"' "$DATA_DIR/settings.json" 2>/dev/null | grep -o '[0-9]*$' || true)
    if [[ -n "$sport" ]]; then
      dbg "get_worker_port: found port $sport in settings.json"
      echo "$sport"
      return
    fi
  fi
  local default_port="$(( 37700 + $(id -u) % 100 ))"
  dbg "get_worker_port: using default port $default_port"
  echo "$default_port"
}

check_worker_running() {
  local port
  port=$(get_worker_port)
  dbg "check_worker_running: curl -sf http://127.0.0.1:${port}/api/health --connect-timeout 2 --max-time 3"
  curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 2 --max-time 3 2>/dev/null
}

is_windows_shell() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) return 0 ;;
    *) return 1 ;;
  esac
}

find_pid_listening_on_port() {
  local port="$1"
  local pid=""

  if is_windows_shell; then
    # Git Bash/MSYS normally lacks lsof/fuser. netstat -ano is available on
    # Windows and prints the owning PID as the last column.
    pid=$(netstat -ano 2>/dev/null | awk -v p=":$port" '
      $0 ~ p && $0 ~ /LISTENING/ { print $NF; exit }
    ' || true)
  else
    if command -v lsof >/dev/null 2>&1; then
      pid=$(lsof -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null | head -1 || true)
    fi
    if [[ -z "$pid" ]] && command -v fuser >/dev/null 2>&1; then
      pid=$(fuser "${port}/tcp" 2>/dev/null | grep -o '[0-9]*' | head -1 || true)
    fi
  fi

  echo "$pid"
}

terminate_worker_pid() {
  local pid="$1"
  if [[ -z "$pid" ]]; then return 0; fi

  if is_windows_shell && command -v taskkill >/dev/null 2>&1; then
    taskkill //PID "$pid" //T //F >/dev/null 2>&1 || true
    return 0
  fi

  kill "$pid" 2>/dev/null || true
  sleep 2
  if ps -p "$pid" >/dev/null 2>&1; then
    dbg "terminate_worker_pid: force-killing pid=$pid"
    kill -9 "$pid" 2>/dev/null || true
  fi
}

check_codex_cli() {
  command -v codex &>/dev/null
}

check_codex_marketplace() {
  check_codex_cli && codex plugin marketplace list 2>/dev/null | awk -v name="$CODEX_MARKETPLACE_NAME" '$1 == name { found = 1 } END { exit(found ? 0 : 1) }'
}

check_codex_plugin_available() {
  check_codex_cli && codex plugin list 2>/dev/null | awk -v selector="$CODEX_PLUGIN_SELECTOR" '$1 == selector { found = 1 } END { exit(found ? 0 : 1) }'
}

check_codex_plugin_installed() {
  # Codex lists marketplace-visible plugins even when they are not installed.
  # Require the STATUS column to be "installed" so reinstall does not skip
  # the real `codex plugin add` step.
  check_codex_cli && codex plugin list 2>/dev/null | awk -v selector="$CODEX_PLUGIN_SELECTOR" '$1 == selector && $2 ~ /^installed/ { found = 1 } END { exit(found ? 0 : 1) }'
}

# ── tree-sitter binary handling (local-first, proxy fallback) ───────
# tree-sitter-cli@0.26.x postinstall fetches a ~7MB gz from github.com release
# CDN and hard-wires the URL. To avoid this fragile download we skip its
# postinstall (by removing from trustedDependencies) and inject the binary
# ourselves. Source preference:
#   1. ./download/tree-sitter-macos-<arch>.gz  in this repo
#   2. Prompt for SOCKS5 proxy port → curl --socks5-hostname download

case "$(uname -s)" in
  Darwin) TS_OS="macos" ;;
  Linux)  TS_OS="linux" ;;
  MINGW*|MSYS*|CYGWIN*) TS_OS="windows" ;;
  *) TS_OS="" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) TS_ARCH="x64" ;;
  arm64|aarch64) TS_ARCH="arm64" ;;
  i386|i686) TS_ARCH="x86" ;;
  *) TS_ARCH="" ;;
esac
LOCAL_TS_BINARY_GZ="$SCRIPT_DIR/download/tree-sitter-${TS_OS}-${TS_ARCH}.gz"

# Files we'll patch in-place (and restore) during sync.
PKGJSON_BACKUPS=()

ensure_treesitter_binary() {
  if [[ -z "$TS_OS" || -z "$TS_ARCH" ]]; then
    fail "Unsupported platform: $(uname -s)/$(uname -m)"
    exit 1
  fi

  if [[ -f "$LOCAL_TS_BINARY_GZ" ]]; then
    ok "Using local tree-sitter binary: $LOCAL_TS_BINARY_GZ"
    return
  fi

  warn "Local tree-sitter binary not found: $LOCAL_TS_BINARY_GZ"
  info "Will download via SOCKS5 proxy. Provide your local proxy port."
  printf "  SOCKS5 port [default 7890]: "
  local user_port
  read -r user_port
  user_port="${user_port:-7890}"

  if ! curl -sf --connect-timeout 3 --socks5-hostname "127.0.0.1:$user_port" \
       https://github.com -o /dev/null 2>/dev/null; then
    fail "SOCKS5 proxy at 127.0.0.1:$user_port not reachable"
    exit 1
  fi

  # Determine tree-sitter-cli version pinned in plugin/package.json (most
  # specific) — falls back to a known recent version if parsing fails.
  local ts_version
  ts_version="$(node -p "
    const v = require('$SCRIPT_DIR/plugin/package.json').dependencies['tree-sitter-cli'];
    v.replace(/^[^0-9]+/, '');
  " 2>/dev/null || echo '0.26.8')"

  local url="https://github.com/tree-sitter/tree-sitter/releases/download/v${ts_version}/tree-sitter-${TS_OS}-${TS_ARCH}.gz"
  mkdir -p "$SCRIPT_DIR/download"
  info "Downloading tree-sitter v${ts_version} via socks5://127.0.0.1:$user_port..."
  if curl -fL --socks5-hostname "127.0.0.1:$user_port" \
       --connect-timeout 10 --max-time 120 \
       -o "$LOCAL_TS_BINARY_GZ" "$url"; then
    ok "Downloaded to $LOCAL_TS_BINARY_GZ"
  else
    fail "Download failed from $url"
    rm -f "$LOCAL_TS_BINARY_GZ"
    exit 1
  fi
}

patch_pkgjson_skip_treesitter() {
  # Temporarily remove tree-sitter-cli from trustedDependencies so bun won't
  # run its postinstall (which hard-codes the github.com download URL).
  local f
  for f in "$SCRIPT_DIR/package.json" "$SCRIPT_DIR/plugin/package.json"; do
    [[ -f "$f" ]] || continue
    cp -p "$f" "${f}.install-bak"
    PKGJSON_BACKUPS+=("$f")
    local tmp
    tmp="$(mktemp)"
    jq '.trustedDependencies = ((.trustedDependencies // []) | map(select(. != "tree-sitter-cli")))' \
       "$f" > "$tmp"
    cat "$tmp" > "$f"
    rm -f "$tmp"
  done
  info "Disabled tree-sitter-cli postinstall in package.json (will restore after sync)"
}

restore_pkgjson() {
  local f
  for f in "${PKGJSON_BACKUPS[@]:-}"; do
    [[ -z "$f" ]] && continue
    if [[ -f "${f}.install-bak" ]]; then
      mv "${f}.install-bak" "$f"
    fi
  done
  PKGJSON_BACKUPS=()
}

inject_treesitter_binary() {
  local target_node_modules="$1"
  local ts_dir="$target_node_modules/tree-sitter-cli"
  local ts_exe="tree-sitter"
  if is_windows_shell; then
    ts_exe="tree-sitter.exe"
  fi
  if [[ ! -d "$ts_dir" ]]; then
    warn "tree-sitter-cli not in $target_node_modules — skip injection"
    return
  fi
  gunzip -c "$LOCAL_TS_BINARY_GZ" > "$ts_dir/$ts_exe"
  chmod +x "$ts_dir/$ts_exe"
  ok "Injected tree-sitter binary: $ts_dir/$ts_exe"
}

# Restore package.json files even if the script aborts mid-sync.
trap restore_pkgjson EXIT

# ── Local registration (no npx, no upstream fetch) ──────────────────
require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    fail "jq not found — required for local registration"
    info "Install: brew install jq"
    exit 1
  fi
}

json_patch() {
  # json_patch <file> <jq-filter>  — in-place update; creates {} if missing.
  # Symlink-safe: writes through the link via shell redirection (`>`) so a
  # symlinked settings.json keeps pointing at its real target after the patch.
  local file="$1"
  local filter="$2"
  local tmp
  tmp="$(mktemp)"
  mkdir -p "$(dirname "$file")"
  if [[ -f "$file" ]]; then
    jq "$filter" "$file" > "$tmp"
  else
    echo '{}' | jq "$filter" > "$tmp"
  fi
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

register_plugin_local() {
  require_jq
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%S.000Z)"

  # 1) known_marketplaces.json — autoUpdate:false 防止 Claude Code 自动从 upstream 拉取覆盖
  json_patch "$KNOWN_MARKETPLACES" \
    ".\"thedotmack\" = {
       source: { source: \"github\", repo: \"thedotmack/claude-mem\" },
       installLocation: \"$MARKETPLACE_DIR\",
       lastUpdated: \"$now\",
       autoUpdate: false
     }"
  ok "Marketplace registered (autoUpdate=false → 不会被 upstream 覆盖)"

  # 2) installed_plugins.json
  json_patch "$INSTALLED_PLUGINS" \
    "(.version //= 2) | (.plugins //= {}) |
     .plugins[\"claude-mem@thedotmack\"] = [{
       scope: \"user\",
       installPath: \"$PLUGIN_CACHE_DIR\",
       version: \"$LOCAL_VERSION\",
       installedAt: \"$now\",
       lastUpdated: \"$now\"
     }]"
  ok "Plugin recorded (v$LOCAL_VERSION)"

  # 3) settings.json — 启用插件 + 禁用 Claude Code 内置 auto-memory
  json_patch "$CLAUDE_SETTINGS" \
    "(.enabledPlugins //= {}) |
     .enabledPlugins[\"claude-mem@thedotmack\"] = true |
     (.env //= {}) |
     .env.CLAUDE_CODE_DISABLE_AUTO_MEMORY = \"1\""
  ok "Plugin enabled in settings.json, auto-memory disabled"
}

unregister_plugin_local() {
  require_jq

  if [[ -f "$KNOWN_MARKETPLACES" ]]; then
    json_patch "$KNOWN_MARKETPLACES" 'del(.thedotmack)'
    ok "Marketplace entry removed"
  fi

  if [[ -f "$INSTALLED_PLUGINS" ]]; then
    json_patch "$INSTALLED_PLUGINS" 'del(.plugins."claude-mem@thedotmack")'
    ok "Plugin record removed"
  fi

  if [[ -f "$CLAUDE_SETTINGS" ]]; then
    json_patch "$CLAUDE_SETTINGS" 'del(.enabledPlugins."claude-mem@thedotmack")'
    ok "Plugin disabled in settings.json"
  fi
}

# ── Shared actions ──────────────────────────────────────────────────
do_build() {
  if check_built; then
    ok "Already built"
    return
  fi

  warn "Not built yet — $BUILT_MARKER not found"
  printf "  Run ${BOLD}npm run build${RESET} now? [Y/n] "
  read -r answer
  case "$answer" in
    n*|N*) fail "Build skipped — cannot continue"; exit 1 ;;
  esac

  step "Building claude-mem..."
  (cd "$SCRIPT_DIR" && npm run build)
  if check_built; then
    ok "Build complete"
  else
    fail "Build failed — check errors above"
    exit 1
  fi
}

do_sync() {
  step "Syncing to marketplace..."
  if check_synced; then
    ok "Already synced to $MARKETPLACE_DIR"
    return
  fi
  # sync-marketplace.cjs rsyncs into <cache>/<version>/ but won't mkdir its
  # parents — pre-create so a fresh-state install doesn't trip on first run.
  mkdir -p "$MARKETPLACE_DIR" "$PLUGIN_CACHE_DIR"

  # Make sure the tree-sitter binary is available locally BEFORE we run bun
  # install, then disable the network-dependent postinstall.
  ensure_treesitter_binary
  patch_pkgjson_skip_treesitter

  info "Running npm run sync-marketplace..."
  (cd "$SCRIPT_DIR" && npm run sync-marketplace)

  # Place the binary into both bun-install locations so smart-file-read can
  # actually call it. The marketplace dir runs at runtime; the versioned cache
  # is what Claude Code loads from `installed_plugins.json`.
  inject_treesitter_binary "$MARKETPLACE_DIR/node_modules"
  inject_treesitter_binary "$PLUGIN_CACHE_DIR/node_modules"
  restore_pkgjson
  if check_synced; then
    ok "Synced to marketplace"
  else
    fail "Sync failed"
    exit 1
  fi
}

do_start_worker() {
  step "Starting worker..."
  local port
  port=$(get_worker_port)

  if check_worker_running; then
    ok "Worker already running on port ${port}"
    return
  fi

  if [[ ! -f "$WORKER_SCRIPT" ]]; then
    fail "Worker script not found at $WORKER_SCRIPT"
    info "Run sync first: npm run sync-marketplace"
    return 1
  fi

  info "Starting local worker via bun..."
  bun "$WORKER_SCRIPT" start >/dev/null 2>&1 || true

  local retries=0
  while [[ $retries -lt 10 ]]; do
    if curl -sf "http://127.0.0.1:${port}/api/health" -o /dev/null --connect-timeout 1 --max-time 2 2>/dev/null; then
      ok "Worker started on port ${port}"
      return
    fi
    retries=$((retries + 1))
    sleep 1
  done

  warn "Worker health check timed out — it may still be starting"
  info "Check status: bun $WORKER_SCRIPT status"
}

do_stop_worker() {
  step "Stopping worker..."
  dbg "do_stop_worker: WORKER_SCRIPT=$WORKER_SCRIPT PID_FILE=$PID_FILE DATA_DIR=$DATA_DIR"

  local running
  if check_worker_running; then
    running=1
    dbg "do_stop_worker: worker IS running (health check ok)"
  else
    running=0
    dbg "do_stop_worker: worker is NOT running"
  fi

  if [[ "$running" -eq 0 ]] && [[ ! -f "$PID_FILE" ]]; then
    dbg "do_stop_worker: no PID file and not running — nothing to do"
    ok "Worker not running"
    return
  fi

  # Try graceful stop via worker script with a 5s timeout.
  if [[ -f "$WORKER_SCRIPT" ]]; then
    if command -v bun >/dev/null 2>&1; then
      info "Stopping worker via bun (timeout 5s)..."
      dbg "do_stop_worker: running: bun $WORKER_SCRIPT stop"
      bun "$WORKER_SCRIPT" stop >/dev/null 2>&1 &
      local stop_pid=$!
      dbg "do_stop_worker: bun stop pid=$stop_pid"
      local waited=0
      while [[ $waited -lt 5 ]]; do
        if ! kill -0 "$stop_pid" 2>/dev/null; then
          dbg "do_stop_worker: bun stop exited after ${waited}s"
          break
        fi
        sleep 1
        waited=$((waited + 1))
      done
      if kill -0 "$stop_pid" 2>/dev/null; then
        dbg "do_stop_worker: killing hung bun stop (pid=$stop_pid)"
        kill "$stop_pid" 2>/dev/null || true
      fi
      wait "$stop_pid" 2>/dev/null || true
    else
      dbg "do_stop_worker: bun not found, skipping graceful stop"
    fi
  else
    dbg "do_stop_worker: WORKER_SCRIPT not found at $WORKER_SCRIPT"
  fi

  # Belt-and-braces: kill by PID file if still alive.
  local pid=""
  if [[ -f "$PID_FILE" ]]; then
    pid=$(grep -o '"pid":[[:space:]]*[0-9]*' "$PID_FILE" 2>/dev/null | grep -o '[0-9]*$' || true)
    dbg "do_stop_worker: PID file pid=$pid"
  fi
  if [[ -z "$pid" ]] || { ! is_windows_shell && ! ps -p "$pid" >/dev/null 2>&1; }; then
    # Fallback: find worker by port when PID file is missing or stale
    local port
    port=$(get_worker_port)
    dbg "do_stop_worker: trying to find worker on port $port"
    pid=$(find_pid_listening_on_port "$port")
    dbg "do_stop_worker: port-based pid=$pid"
  fi

  if [[ -n "$pid" ]] && { is_windows_shell || ps -p "$pid" >/dev/null 2>&1; }; then
    dbg "do_stop_worker: killing pid=$pid"
    terminate_worker_pid "$pid"
  fi

  if check_worker_running; then
    warn "Worker may still be running"
  else
    ok "Worker stopped"
  fi
}

