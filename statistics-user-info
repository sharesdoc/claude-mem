#!/usr/bin/env bash
set -euo pipefail

# statistics-user-info — 统计指定用户在 N 天内的任务用时信息
#
# 用法:
#   statistics-user-info -h                       显示帮助
#   statistics-user-info -n "Zhan San"             统计今天(默认1天)
#   statistics-user-info -n "张三" -d 3            统计最近3天

DB_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
DB_PATH="$DB_DIR/claude-mem.db"

# ── 工具函数 ───────────────────────────────────────────────────────────────
fmt_dur() {  # ms → 中文耗时
  local ms=${1:-0} h m s
  if (( ms <= 0 )); then echo "0s"; return; fi
  s=$(( (ms / 1000) % 60 ))
  m=$(( (ms / 60000) % 60 ))
  h=$(( ms / 3600000 ))
  if (( h > 0 )); then printf '%dh%dm%ds' "$h" "$m" "$s"
  elif (( m > 0 )); then printf '%dm%ds' "$m" "$s"
  else printf '%ds' "$s"
  fi
}

# ── CLI 解析 ───────────────────────────────────────────────────────────────
NAME=""; DAYS=1; HELP=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) HELP=true ;;
    -n|--name) NAME="${2:-}"; shift ;;
    -d|--days) DAYS="${2:-1}"; shift ;;
    -*) echo "未知选项: $1"; exit 1 ;;
    *) [[ -z "$NAME" ]] && NAME="$1" || DAYS="$1" ;;
  esac
  shift
done

if $HELP || [[ -z "$NAME" ]]; then
  [[ -z "$NAME" ]] && ! $HELP && echo "错误: 缺少 -n <用户名>"$'\n'
  echo "statistics-user-info — 统计用户任务用时"
  echo ""
  echo "用法:"
  echo "  statistics-user-info [OPTIONS]"
  echo ""
  echo "选项:"
  echo "  -h, --help              显示此帮助"
  echo "  -n, --name <username>   目标用户名(必填)"
  echo "  -d, --days <N>          统计最近 N 天(默认 1 = 今天)"
  echo ""
  echo "示例:"
  echo "  statistics-user-info -n \"Zhan San\"          今天"
  echo '  statistics-user-info -n "张三" -d 3          最近3天'
  echo '  statistics-user-info -n "Wang Wu" -d 7       最近7天'
  echo ""
  echo "输出:"
  echo "  ① 概览:任务数/总AI/总H/项目数/日均"
  echo "  ② 按项目:各项目任务数/AI/H/合计/占比/平均"
  echo "  ③ 汇总行"
  exit 0
fi

# ── 时间窗口 ───────────────────────────────────────────────────────────────
NOW_S=$(date +%s)
SINCE_EPOCH=$(( (NOW_S - DAYS * 86400) * 1000 ))  # 毫秒
UNTIL_EPOCH=$(( NOW_S * 1000 ))

echo ""
echo "数据库: $DB_PATH"
echo "用户: $NAME    范围: 最近 $DAYS 天 ($(date -r $((SINCE_EPOCH/1000)) '+%Y-%m-%d') ~ $(date '+%Y-%m-%d'))"
echo ""

# ── 查询 ───────────────────────────────────────────────────────────────────
ROWS=$(sqlite3 -separator $'\t' "$DB_PATH" "
  SELECT RTRIM(s.project, '/'), up.created_at_epoch,
         up.completed_at_epoch, COALESCE(up.think_time_ms, 0)
  FROM user_prompts up
  JOIN sdk_sessions s ON s.content_session_id = up.content_session_id
  WHERE up.created_at_epoch >= $SINCE_EPOCH AND up.created_at_epoch <= $UNTIL_EPOCH
    AND COALESCE(NULLIF(s.user_label, ''), 'unknown') = '$NAME' COLLATE NOCASE
  ORDER BY up.created_at_epoch ASC
")

# 用 awk 按项目聚合(兼容 bash 3.x,无需关联数组)
# 输出 TAB 分隔: 项目 cnt done ai h
AGGR=$(echo "$ROWS" | awk -F$'\t' '
  function max(a,b) { return a>b ? a : b }
  {
    proj = ($1 == "" ? "(unknown)" : $1)
    cnt[proj]++
    total++
    if ($3 != "" && $3 != "null" && $3+0 > 0) {
      done_cnt[proj]++
      completed_total++
      ai = max($3 - $2, 0)
      ai_sum[proj] += ai
      h_sum[proj]  += ($4+0)
      total_ai += ai
      total_h += ($4+0)
    }
    # 记录首次出现顺序
    if (!(proj in seen)) { seen[proj] = 1; order = order proj "\n" }
  }
  END {
    printf "%d\t%d\t%d\t%d\n", total, completed_total, total_ai, total_h
    printf "%s", order
    print ""   # 分隔符:空行
    for (p in cnt) printf "%s\t%d\t%d\t%d\t%d\n", p, cnt[p], done_cnt[p], ai_sum[p], h_sum[p]
  }
')
# 第一行: TOTAL TAB COMPLETED TAB TOTAL_AI TAB TOTAL_H
# 后续行: PROJ_ORDER(每行一个项目名) ...空白行(awk 分隔)... PROJ_ROW(项目 TAB cnt TAB done TAB ai TAB h)
# 用 awk 分隔: 首行=总计; 空行前=项目顺序; 空行后=项目数据

TOTAL=$(echo "$AGGR" | head -1 | cut -f1)
COMPLETED=$(echo "$AGGR" | head -1 | cut -f2)
TOTAL_AI=$(echo "$AGGR" | head -1 | cut -f3)
TOTAL_H=$(echo "$AGGR" | head -1 | cut -f4)
TOTAL_TIME=$((TOTAL_AI + TOTAL_H))

# 项目顺序(从第2行到空行前)
PROJ_ORDER=$(echo "$AGGR" | sed '1d' | sed '/^$/q' | sed '/^$/d')

# 项目聚合数据(空行之后): 项目 cnt done ai h
PROJ_DATA=$(echo "$AGGR" | sed '1,/^$/d')

# 按合计耗时降序: 读 PROJ_DATA,算 tt=ai+h,排序输出 项目名
PROJ_SORTED=$(echo "$PROJ_DATA" | awk -F$'\t' '
  { tt = $4 + $5; print tt "\t" $1 }
' | sort -rn | cut -f2-)

# ── 概览 ───────────────────────────────────────────────────────────────────
echo "═══ 概览 ═══"
echo "  任务总数:   $TOTAL"
if (( TOTAL > 0 )); then
  echo "  已完成:     $COMPLETED ($(( COMPLETED * 100 / TOTAL ))%)"
else
  echo "  已完成:     0 (0%)"
fi
echo "  AI 耗时:    $(fmt_dur $TOTAL_AI)"
echo "  人类思考:   $(fmt_dur $TOTAL_H)"
echo "  总耗时:     $(fmt_dur $TOTAL_TIME)"
echo "  涉及项目:   $(echo "$PROJ_ORDER" | grep -c .)"
AVG_TASKS=$(( TOTAL * 10 / DAYS ))
echo "  日均任务:   $((AVG_TASKS / 10)).$((AVG_TASKS % 10))"
echo "  日均耗时:   $(fmt_dur $(( TOTAL_TIME / DAYS )))"
echo ""

# ── 按项目 ─────────────────────────────────────────────────────────────────
echo "═══ 按项目 ═══"
if [[ -z "$PROJ_ORDER" ]]; then
  echo "  (无数据)"
else
  # 构建 TSV → column 自动对齐
  TABLE_TSV=$'项目\t#任务\t完成\tAI耗时\tH耗时\t合计\t占比\t平均/任务\n'
  while IFS= read -r proj; do
    [[ -z "$proj" ]] && continue
    # 从 PROJ_DATA 取该项目的聚合值
    row=$(grep -F "${proj}"$'\t' <<<"$PROJ_DATA" || true)
    cnt=$(echo "$row" | cut -f2); done_cnt=$(echo "$row" | cut -f3)
    ai=$(echo "$row" | cut -f4); h=$(echo "$row" | cut -f5)
    cnt=${cnt:-0}; done_cnt=${done_cnt:-0}; ai=${ai:-0}; h=${h:-0}
    tt=$((ai + h))
    (( TOTAL_TIME > 0 )) && pct="$((tt * 100 / TOTAL_TIME))%" || pct="-"
    if (( done_cnt > 0 )); then avg="$(fmt_dur $(( tt / done_cnt )))"; else avg="-"; fi
    TABLE_TSV+="${proj}\t${cnt}\t${done_cnt}\t$(fmt_dur $ai)\t$(fmt_dur $h)\t$(fmt_dur $tt)\t${pct}\t${avg}"$'\n'
  done <<<"$PROJ_SORTED"
  echo -e "$TABLE_TSV" | column -t -s $'\t' | sed '2,$s/^/  /'
fi

echo '────────────────────────────────────────────────────────────'
echo "  汇总: $TOTAL 任务 / $(fmt_dur $TOTAL_AI) AI + $(fmt_dur $TOTAL_H) H = $(fmt_dur $TOTAL_TIME)"
echo ""
