ZIP="./bun-darwin-x64.zip"

# 1. 解压到临时目录
TMP_DIR="$(mktemp -d)"
unzip -q "$ZIP" -d "$TMP_DIR"

# 2. 找到 bun 可执行文件
BUN_BIN="$(find "$TMP_DIR" -type f -name bun | head -n 1)"

if [ -z "$BUN_BIN" ]; then
  echo "未找到 bun 可执行文件，请检查 zip 内容"
  find "$TMP_DIR" -maxdepth 3 -type f
  exit 1
fi

# 3. 安装到 ~/.bun/bin
mkdir -p "$HOME/.bun/bin"
cp "$BUN_BIN" "$HOME/.bun/bin/bun"
chmod +x "$HOME/.bun/bin/bun"

# 4. 去掉 macOS 隔离属性，避免打不开
xattr -d com.apple.quarantine "$HOME/.bun/bin/bun" 2>/dev/null || true

# 5. 写入 zsh PATH
grep -q 'BUN_INSTALL' "$HOME/.zshrc" 2>/dev/null || cat >> "$HOME/.zshrc" <<'EOF'

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF

# 6. 立即生效
source "$HOME/.zshrc"

# 7. 验证
bun --version
bun --revision
