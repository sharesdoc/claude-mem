#!/usr/bin/env bash
set -euo pipefail

# name-manager — manage claude-mem user labels (list / rename)
#
# Usage:
#   ./name-manager -l                    List all names
#   ./name-manager -n oldname newname    Rename settings only
#   ./name-manager -d oldname newname    Rename settings + database
#
# Mode comparison:
#   -l / --list       List all user names managed by claude-mem across all records.
#   -n / --name       Only changes settings.json.  New sessions use the new label;
#                     old sessions keep the old label.  Both labels appear in the viewer.
#   -d / --database   Changes settings.json AND updates sdk_sessions.user_label in
#                     the SQLite database.  All historical data moves to the new label.
#                     Auto-stops/restarts the worker to prevent gaps.

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; RESET=$'\033[0m'

ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "  ${RED}✗${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }

show_help() {
  cat <<EOF
name-manager — manage claude-mem user labels (list / rename)

Usage:
  ./name-manager -l                        List all names
  ./name-manager -n <oldname> <newname>    Rename settings only
  ./name-manager -d <oldname> <newname>    Rename settings + database

Options:
  -l, --list       List all user names in the database with record counts.
  -n, --name       Update only ~/.claude-mem/settings.json.
                   Old sessions keep the old label (seen in viewer dropdown).
  -d, --database   Update settings.json AND the SQLite database.
                   ALL historical data moves to the new label.
                   Auto-stops/restarts the worker to avoid gaps.

Examples:
  ./name-manager -l
  ./name-manager -n johnson JOHNSON
  ./name-manager -d alice Alice-Work
EOF
}

# ── Resolve paths ──────────────────────────────────────────────────────
DATA_DIR="${CLAUDE_MEM_DATA_DIR:-$HOME/.claude-mem}"
SETTINGS_FILE="$DATA_DIR/settings.json"
DB_FILE="$DATA_DIR/claude-mem.db"

mode=""
oldname=""
newname=""

# ── Parse args ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--list)     mode="list"; shift ;;
    -n|--name)     mode="name"; shift ;;
    -d|--database) mode="database"; shift ;;
    -h|--help)     show_help; exit 0 ;;
    -*)
      fail "Unknown flag: $1"
      show_help
      exit 1
      ;;
    *)
      if [[ -z "$oldname" ]]; then oldname="$1";
      elif [[ -z "$newname" ]]; then newname="$1";
      else
        fail "Too many arguments"; show_help; exit 1
      fi
      shift
      ;;
  esac
done

# ── -l / --list: dump all names with record counts ───────────────────
if [[ "$mode" == "list" ]]; then
  if [[ ! -f "$DB_FILE" ]]; then
    fail "Database not found: $DB_FILE"
    exit 1
  fi
  if ! command -v sqlite3 &>/dev/null; then
    fail "sqlite3 not found"
    exit 1
  fi

  echo ""
  printf "  %-24s %10s %10s %10s %10s\n" "NAME" "SESSIONS" "OBS" "PROMPTS" "SUMMARIES"
  printf "  %-24s %10s %10s %10s %10s\n" "------------------------" "----------" "----------" "----------" "----------"

  sqlite3 -separator '|' "$DB_FILE" "
    SELECT
      COALESCE(NULLIF(s.user_label, ''), '(empty)') AS name,
      COUNT(DISTINCT s.id) AS sessions,
      COUNT(DISTINCT o.id) AS obs,
      COUNT(DISTINCT up.id) AS prompts,
      COUNT(DISTINCT ss.id) AS summaries
    FROM sdk_sessions s
    LEFT JOIN observations o ON o.memory_session_id = s.memory_session_id
    LEFT JOIN user_prompts up ON up.content_session_id = s.content_session_id
    LEFT JOIN session_summaries ss ON ss.memory_session_id = s.memory_session_id
    GROUP BY name
    ORDER BY sessions DESC
  " 2>/dev/null | while IFS='|' read -r name sessions obs prompts summaries; do
    printf "  %-24s %10s %10s %10s %10s\n" "$name" "$sessions" "$obs" "$prompts" "$summaries"
  done

  echo ""
  exit 0
fi

if [[ -z "$mode" || -z "$oldname" || -z "$newname" ]]; then
  fail "Missing required arguments"
  show_help
  exit 1
fi

# Escape single quotes for SQLite (SQL standard: '' → literal single quote)
sql_escape() { echo "$1" | sed "s/'/''/g"; }

# Normalise to lowercase for equality checks, but preserve original case for
# the DB query (COLLATE NOCASE handles it) and settings write (exact new name).
OLD_LOWER="$(echo "$oldname" | tr '[:upper:]' '[:lower:]')"
NEW_LOWER="$(echo "$newname" | tr '[:upper:]' '[:lower:]')"

OLD_SQL="$(sql_escape "$oldname")"
NEW_SQL="$(sql_escape "$newname")"

if [[ "$OLD_LOWER" == "$NEW_LOWER" ]]; then
  warn "Old and new label differ only in case — renaming case"
fi

echo ""
echo "  Old label : ${YELLOW}${oldname}${RESET}"
echo "  New label : ${GREEN}${newname}${RESET}"
echo "  Mode      : ${mode}"
echo ""

# ── 1. Update settings.json ───────────────────────────────────────────
if [[ ! -f "$SETTINGS_FILE" ]]; then
  fail "Settings file not found: $SETTINGS_FILE"
  exit 1
fi

current=$(node -e "
  try {
    const s = require('$SETTINGS_FILE');
    const v = s.CLAUDE_MEM_USER_LABEL || '';
    console.log(v);
  } catch(e) { console.log(''); }
" 2>/dev/null || echo "")

if [[ "$(echo "$current" | tr '[:upper:]' '[:lower:]')" == "$NEW_LOWER" ]]; then
  ok "Settings already set to '$newname' (case-insensitive)"
else
  node -e "
    const fs = require('fs');
    const file = process.argv[1];
    const label = process.argv[2];
    let raw = {};
    try { raw = JSON.parse(fs.readFileSync(file, 'utf-8')); } catch(e) {}
    raw.CLAUDE_MEM_USER_LABEL = label;
    fs.writeFileSync(file, JSON.stringify(raw, null, 2) + '\n');
  " "$SETTINGS_FILE" "$newname"
  ok "Settings updated: CLAUDE_MEM_USER_LABEL = '$newname'"
fi

# ── 2. Database update (--database only) ───────────────────────────────
if [[ "$mode" == "database" ]]; then
  if [[ ! -f "$DB_FILE" ]]; then
    fail "Database not found: $DB_FILE"
    exit 1
  fi

  # Check if sqlite3 is available
  if ! command -v sqlite3 &>/dev/null; then
    fail "sqlite3 not found — install it and retry"
    exit 1
  fi

  # Count affected rows before update
  before=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM sdk_sessions WHERE user_label='${OLD_SQL}' COLLATE NOCASE;" 2>/dev/null || echo 0)
  if [[ "$before" -eq 0 ]]; then
    ok "No sessions with label '$oldname' (case-insensitive) in database — nothing to migrate"
  else
    # Stop worker to prevent new sessions with old label during the rename window
    WORKER_SCRIPT="$(dirname "$0")/plugin/scripts/worker-service.cjs"
    if [[ -f "$WORKER_SCRIPT" ]]; then
      echo ""
      echo "  Stopping worker …"
      bun "$WORKER_SCRIPT" stop 2>/dev/null || true
      sleep 1
    fi

    sqlite3 "$DB_FILE" "UPDATE sdk_sessions SET user_label='${NEW_SQL}' WHERE user_label='${OLD_SQL}' COLLATE NOCASE;"
    ok "Migrated ${before} session(s) from '$oldname' (case-insensitive) → '$newname'"

    # Restart worker so new sessions use the new label immediately
    if [[ -f "$WORKER_SCRIPT" ]]; then
      echo ""
      echo "  Restarting worker …"
      bun "$WORKER_SCRIPT" start 2>/dev/null || true
      ok "Worker restarted — new sessions will use '$newname'"
    fi
  fi
fi

echo ""
ok "Done"
