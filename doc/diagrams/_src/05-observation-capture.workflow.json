{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "观测捕获与生成流程",
    "subtitle": "本地 Worker · PostToolUse → 压缩 → 持久化 → 推送",
    "output": "05-observation-capture.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "client", "label": "AI 助手 / Hook / Viewer" },
    { "id": "worker", "label": "本地 Worker" },
    { "id": "async", "label": "异步处理", "variant": "exception" }
  ],
  "mainPath": ["tool", "adapt", "post", "queue", "provider", "strip", "save", "sse"],
  "nodes": [
    { "id": "tool", "lane": "client", "col": 0, "type": "frontend", "label": "工具调用", "sublabel": "PostToolUse" },
    { "id": "adapt", "lane": "client", "col": 2, "type": "backend", "label": "适配+校验", "sublabel": "归一化+追踪" },
    { "id": "sse", "lane": "client", "col": 5, "type": "frontend", "label": "SSE 广播", "sublabel": "Viewer 实时流" },

    { "id": "post", "lane": "worker", "col": 2, "type": "backend", "label": "POST", "sublabel": "/observations", "width": 100 },
    { "id": "queue", "lane": "worker", "col": 3, "type": "messagebus", "label": "消息队列", "sublabel": "PendingMessage", "width": 100 },
    { "id": "save", "lane": "worker", "col": 5, "type": "database", "label": "持久化", "sublabel": "SQLite 去重" },

    { "id": "provider", "lane": "async", "col": 4, "type": "backend", "label": "AI Provider", "sublabel": "压缩（备用链）" },
    { "id": "strip", "lane": "async", "col": 5, "type": "security", "label": "隐私剥离", "sublabel": "6 类标签" }
  ],
  "edges": [
    { "id": "e1", "from": "tool", "to": "adapt" },
    { "id": "e2", "from": "adapt", "to": "post", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "e3", "from": "post", "to": "queue" },
    { "id": "e4", "from": "queue", "to": "provider", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "e5", "from": "provider", "to": "strip" },
    { "id": "e6", "from": "strip", "to": "save", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "drop" },
    { "id": "e7", "from": "save", "to": "sse", "fromSide": "top", "toSide": "bottom", "route": "drop" }
  ],
  "cards": [
    { "dot": "rose", "title": "非阻断规则", "items": ["Worker 不可用静默跳过", "不追踪项目跳过", "exit 0 不阻塞 AI"] },
    { "dot": "cyan", "title": "去重与隐私", "items": ["memory_session_id + content_hash 去重", "Provider 不可恢复走备用链", "隐私标签入库前剥离"] }
  ]
}
