{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Server Beta 事件摄入与异步生成",
    "subtitle": "Postgres 权威源 + BullMQ 传输 + Outbox 最终一致",
    "output": "06-server-beta-ingest.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "client", "label": "客户端 / HTTP" },
    { "id": "ingest", "label": "摄入同步链" },
    { "id": "queue", "label": "BullMQ 异步链", "variant": "exception" }
  ],
  "mainPath": ["recv", "authz", "ingestsvc", "commit", "resp"],
  "nodes": [
    { "id": "recv", "lane": "client", "col": 0, "type": "frontend", "label": "接收", "sublabel": "POST /v1/events" },
    { "id": "resp", "lane": "client", "col": 5, "type": "frontend", "label": "202 响应", "sublabel": "jobId 立即返回" },

    { "id": "authz", "lane": "ingest", "col": 1, "type": "security", "label": "鉴权", "sublabel": "write+Zod" },
    { "id": "ingestsvc", "lane": "ingest", "col": 3, "type": "backend", "label": "IngestEvents", "sublabel": "write-then-publish" },
    { "id": "commit", "lane": "ingest", "col": 5, "type": "database", "label": "Postgres", "sublabel": "事务 event+outbox" },

    { "id": "publish", "lane": "queue", "col": 5, "type": "messagebus", "label": "BullMQ", "sublabel": "确定性 jobId" },
    { "id": "aigen", "lane": "queue", "col": 3, "type": "backend", "label": "AI 生成", "sublabel": "锁定+XML" },
    { "id": "persist", "lane": "queue", "col": 1, "type": "database", "label": "持久化", "sublabel": "Observation 幂等" }
  ],
  "edges": [
    { "id": "e1", "from": "recv", "to": "authz", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "e2", "from": "authz", "to": "ingestsvc" },
    { "id": "e3", "from": "ingestsvc", "to": "commit", "label": "事务", "variant": "emphasis" },
    { "id": "e4", "from": "commit", "to": "resp", "fromSide": "top", "toSide": "bottom", "route": "drop" },
    { "id": "e5", "from": "commit", "to": "publish", "label": "投递", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "e6", "from": "publish", "to": "aigen", "label": "领取" },
    { "id": "e7", "from": "aigen", "to": "persist", "label": "XML→Obs", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "rose", "title": "Outbox 最终一致", "items": ["先写 Postgres outbox 行再发 BullMQ", "BullMQ 失败不回滚事务", "启动 reconcile 重发残留"] },
    { "dot": "cyan", "title": "三重幂等", "items": ["jobId = kind + SHA-256（不含冒号）", "generation_key UNIQUE", "ON CONFLICT upsert"] },
    { "dot": "emerald", "title": "错误处理", "items": ["6 类标准化错误分类", "指数退避 5s→25s→125s 上限 10min", "失败 job 标 queued 可重试或 failed"] }
  ]
}
